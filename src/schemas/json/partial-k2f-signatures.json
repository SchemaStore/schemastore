{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.schemastore.org/partial-k2f-signatures.json",
  "title": "K2F Signatures v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "signatures"],
  "properties": {
    "version": {
      "const": 1
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alg", "public_key", "signature", "signed_at"],
        "properties": {
          "alg": {
            "const": "ed25519"
          },
          "public_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "signed_at": {
            "type": "integer",
            "minimum": 0,
            "description": "UTC unix seconds."
          },
          "signed_by": {
            "type": "string"
          }
        }
      }
    }
  }
}
