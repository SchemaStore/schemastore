{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/ttheme-palette.json",
  "title": "ttheme palette",
  "description": "One ttheme palette: the colors a terminal shows, and the work or character they are of. Its file name is its name\nhttps://github.com/kecan0406/ttheme/blob/main/CONTRIBUTING.md#the-file",
  "type": "object",
  "definitions": {
    "color": {
      "description": "A color as #rrggbb, lowercase",
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "slot": {
      "description": "One of the palette's twenty colors",
      "type": "string",
      "enum": [
        "background",
        "foreground",
        "cursor",
        "selection",
        "ansi0",
        "ansi1",
        "ansi2",
        "ansi3",
        "ansi4",
        "ansi5",
        "ansi6",
        "ansi7",
        "ansi8",
        "ansi9",
        "ansi10",
        "ansi11",
        "ansi12",
        "ansi13",
        "ansi14",
        "ansi15"
      ]
    },
    "site": {
      "description": "A site ttheme find searches",
      "anyOf": [
        {
          "enum": ["danbooru", "konachan", "yande", "zerochan"]
        },
        {
          "type": "string"
        }
      ]
    },
    "shade": {
      "description": "The palette's colors in its other mode",
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/properties/colors/properties/background"
        },
        "foreground": {
          "$ref": "#/properties/colors/properties/foreground"
        },
        "cursor": {
          "$ref": "#/properties/colors/properties/cursor"
        },
        "selection_background": {
          "$ref": "#/properties/colors/properties/selection_background"
        },
        "ansi": {
          "$ref": "#/properties/colors/properties/ansi"
        }
      },
      "required": [
        "background",
        "foreground",
        "cursor",
        "selection_background",
        "ansi"
      ]
    }
  },
  "properties": {
    "$schema": {
      "description": "This file's JSON Schema, for editor completion and checks; ttheme ignores it",
      "type": "string"
    },
    "subject": {
      "description": "What the palette is of: a work in the commons, as <work>, or one of its characters, as <work>/<character>. Lists shelve the palette under that work. A palette with no subject is an original, listed under its marketplace\nhttps://ttheme.dev/docs/creating-palettes/publish",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)?$",
      "not": {
        "pattern": "^ttheme(?:/|$)"
      },
      "maxLength": 81
    },
    "from": {
      "description": "The palette this one was copied from, by its full name: ttheme/<palette> for a built-in one, or <owner>@<marketplace>/<palette>, so a copy keeps saying whose it was",
      "type": "string",
      "pattern": "^(?:ttheme|[a-z0-9]+(?:-[a-z0-9]+)*@[a-z0-9]+(?:-[a-z0-9]+)*)/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 121
    },
    "signature": {
      "description": "The palette's three colors that identify it, the ones a card draws as its own, which must differ",
      "type": "array",
      "items": {
        "$ref": "#/definitions/slot"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "ansi_source": {
      "description": "What the ANSI colors were derived from, such as a base scheme. A built-in palette names it; any other palette that leaves it out reads as original",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "colors": {
      "description": "The colors the terminal shows, in the mode the palette was made in: light when its background is lighter than its foreground",
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/definitions/color",
          "description": "The terminal's background"
        },
        "foreground": {
          "$ref": "#/definitions/color",
          "description": "The text color"
        },
        "cursor": {
          "$ref": "#/definitions/color",
          "description": "The cursor's color"
        },
        "selection_background": {
          "$ref": "#/definitions/color",
          "description": "The background of selected text"
        },
        "ansi": {
          "description": "The sixteen ANSI colors, black to bright white",
          "type": "array",
          "items": {
            "$ref": "#/definitions/color"
          },
          "minItems": 16,
          "maxItems": 16
        },
        "light": {
          "$ref": "#/definitions/shade",
          "description": "The palette in light mode, for a palette made dark. A built-in palette carries its other mode; without one, ttheme mirrors it"
        },
        "dark": {
          "$ref": "#/definitions/shade",
          "description": "The palette in dark mode, for a palette made light. A built-in palette carries its other mode; without one, ttheme mirrors it"
        }
      },
      "required": [
        "background",
        "foreground",
        "cursor",
        "selection_background",
        "ansi"
      ],
      "not": {
        "properties": {
          "light": {},
          "dark": {}
        },
        "required": ["light", "dark"]
      }
    },
    "contrast": {
      "description": "Contrast checks this palette is let off, with the reason",
      "type": "object",
      "properties": {
        "waive": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "foreground",
                  "accents",
                  "ansi0-dark",
                  "light-ansi",
                  "ansi8-visible",
                  "selection",
                  "ansi-role",
                  "bright-follows",
                  "distinct",
                  "ansi0-on-accents",
                  "ansi7-on-ansi8",
                  "cvd-red-green"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Contrast checks this palette does not have to pass"
        },
        "reason": {
          "description": "Why the waived rules do not apply; a waiver needs one",
          "type": "string"
        }
      }
    },
    "ghostty": {
      "description": "Ghostty's dock icon colors",
      "type": "object",
      "properties": {
        "icon_ghost": {
          "$ref": "#/definitions/color",
          "description": "The ghost on Ghostty's dock icon"
        },
        "icon_screen": {
          "description": "The screen behind the ghost on Ghostty's dock icon: one color, or several drawn as a gradient",
          "anyOf": [
            {
              "$ref": "#/definitions/color"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/color"
              },
              "minItems": 1
            }
          ]
        }
      }
    },
    "picture": {
      "description": "Background pictures, by their post on a find site, with their framing",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site": {
            "$ref": "#/definitions/site",
            "description": "The site the post is on"
          },
          "id": {
            "description": "The post's number on the site",
            "type": "integer",
            "minimum": 1
          },
          "size": {
            "description": "How large the picture is drawn: fill covers the window, a number is a percentage of it",
            "anyOf": [
              {
                "const": "fill"
              },
              {
                "type": "integer",
                "minimum": 20,
                "maximum": 999
              }
            ]
          },
          "position": {
            "description": "Where the picture sits in the window",
            "anyOf": [
              {
                "enum": [
                  "top-left",
                  "top-center",
                  "top-right",
                  "center-left",
                  "center",
                  "center-right",
                  "bottom-left",
                  "bottom-center",
                  "bottom-right"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "opacity": {
            "description": "How strongly the picture shows through the palette's background",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["site", "id"]
      },
      "minItems": 1,
      "maxItems": 8
    }
  },
  "required": ["signature", "colors"]
}
