{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/ttheme-palette.json",
  "title": "ttheme palette",
  "description": "One ttheme palette: the colors a terminal wears and the character they come from\nhttps://github.com/kecan0406/ttheme/blob/main/CONTRIBUTING.md#the-file",
  "type": "object",
  "definitions": {
    "color": {
      "description": "A color as #rrggbb, lowercase",
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "palette": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "slot": {
      "description": "One of the palette's twenty colors",
      "type": "string",
      "enum": [
        "background",
        "foreground",
        "cursor",
        "selection",
        "ansi0",
        "ansi1",
        "ansi2",
        "ansi3",
        "ansi4",
        "ansi5",
        "ansi6",
        "ansi7",
        "ansi8",
        "ansi9",
        "ansi10",
        "ansi11",
        "ansi12",
        "ansi13",
        "ansi14",
        "ansi15"
      ]
    },
    "site": {
      "description": "A site ttheme find searches",
      "anyOf": [
        {
          "enum": ["danbooru", "konachan", "yande", "zerochan"]
        },
        {
          "type": "string"
        }
      ]
    },
    "tags": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\S+$"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\S+$"
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "description": "This file's JSON Schema, for editor completion and checks; ttheme ignores it",
      "type": "string"
    },
    "meta": {
      "description": "Who the palette is and how it is listed",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/palette",
          "description": "The palette's name, the same as its file name without .toml"
        },
        "base": {
          "$ref": "#/definitions/palette",
          "description": "In a market, the official palette this one varies, which only says where its ANSI colors came from"
        },
        "group": {
          "description": "The series the palette belongs to; in the official catalog it needs a [[group]] in themes/_groups.toml, and a market palette's group is its market",
          "type": "string"
        },
        "order": {
          "description": "The official palette's place in the new-tab rotation; a market palette has none",
          "type": "integer"
        },
        "role": {
          "description": "\"default\" marks the official catalog's neutral palette; a market palette has none",
          "type": "string",
          "enum": ["default"]
        },
        "ansi_source": {
          "description": "What the ANSI colors were derived from, such as a base scheme",
          "type": "string"
        },
        "booru": {
          "description": "The character's danbooru tag, which find searches for pictures",
          "type": "string",
          "pattern": "^\\S+$"
        },
        "booru_sites": {
          "description": "The tag on sites that name the character otherwise: one tag, or a list find searches together; an empty list skips the site",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/site"
          },
          "additionalProperties": {
            "$ref": "#/definitions/tags"
          }
        },
        "native_names": {
          "description": "The character's names in its original language, the full name first; preview and browse search them",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^|]+$"
          },
          "minItems": 1
        },
        "signature": {
          "description": "The three slots that identify the character, which must be three different colors",
          "type": "array",
          "items": {
            "$ref": "#/definitions/slot"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": ["name", "signature"]
    },
    "colors": {
      "description": "The colors the terminal wears",
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/definitions/color",
          "description": "The terminal's background"
        },
        "foreground": {
          "$ref": "#/definitions/color",
          "description": "The text color"
        },
        "cursor": {
          "$ref": "#/definitions/color",
          "description": "The cursor's color"
        },
        "selection_background": {
          "$ref": "#/definitions/color",
          "description": "The background of selected text"
        },
        "ansi": {
          "description": "The sixteen ANSI colors, black to bright white",
          "type": "array",
          "items": {
            "$ref": "#/definitions/color"
          },
          "minItems": 16,
          "maxItems": 16
        }
      },
      "required": [
        "background",
        "foreground",
        "cursor",
        "selection_background",
        "ansi"
      ]
    },
    "contrast": {
      "description": "Contrast gate rules this palette is let off, with the reason",
      "type": "object",
      "properties": {
        "waive": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "foreground",
                  "accents",
                  "ansi0-dark",
                  "light-ansi",
                  "ansi8-visible",
                  "selection",
                  "ansi-role",
                  "bright-follows",
                  "distinct"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Contrast gate rules this palette does not have to pass"
        },
        "reason": {
          "description": "Why the waived rules do not apply; a waiver needs one",
          "type": "string"
        }
      }
    },
    "ghostty": {
      "description": "Ghostty's dock icon colors",
      "type": "object",
      "properties": {
        "icon_ghost": {
          "$ref": "#/definitions/color",
          "description": "The ghost on Ghostty's dock icon"
        },
        "icon_screen": {
          "description": "The screen behind the ghost on Ghostty's dock icon: one color, or several drawn as a gradient",
          "anyOf": [
            {
              "$ref": "#/definitions/color"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/color"
              },
              "minItems": 1
            }
          ]
        }
      }
    },
    "picture": {
      "description": "Background pictures, by their post on a find site, with their framing",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site": {
            "$ref": "#/definitions/site",
            "description": "The site the post is on"
          },
          "id": {
            "description": "The post's number on the site",
            "type": "integer",
            "minimum": 1
          },
          "size": {
            "description": "How large the picture is drawn: fill covers the window, a number is a percentage of it",
            "anyOf": [
              {
                "const": "fill"
              },
              {
                "type": "integer",
                "minimum": 20,
                "maximum": 999
              }
            ]
          },
          "position": {
            "description": "Where the picture sits in the window",
            "anyOf": [
              {
                "enum": [
                  "top-left",
                  "top-center",
                  "top-right",
                  "center-left",
                  "center",
                  "center-right",
                  "bottom-left",
                  "bottom-center",
                  "bottom-right"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "opacity": {
            "description": "How strongly the picture shows through the palette's background",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["site", "id"]
      },
      "minItems": 1,
      "maxItems": 8
    }
  },
  "required": ["meta", "colors"]
}
