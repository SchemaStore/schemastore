{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/quikrun.json",
  "$defs": {
    "AutoExit": {
      "enum": ["always", "never", "on_success"],
      "type": "string"
    },
    "CmdCommand": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/CmdCommand"
          },
          "type": "object"
        }
      ]
    },
    "CmdConfig": {
      "additionalProperties": {
        "$ref": "#/$defs/CmdCommand"
      },
      "type": "object"
    },
    "Platform": {
      "enum": ["auto", "linux", "win", "darwin"],
      "type": "string"
    },
    "Shell": {
      "enum": ["auto", "posix", "cmd", "pwsh"],
      "type": "string"
    }
  },
  "title": "quikrun",
  "description": "Configuration for quikrun, a CLI tool to run code files instantly without typing complex commands in terminal.",
  "properties": {
    "shell": {
      "anyOf": [
        {
          "$ref": "#/$defs/Shell"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Which shell to use."
    },
    "platform": {
      "anyOf": [
        {
          "$ref": "#/$defs/Platform"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Target platform or OS override for execution."
    },
    "clear_terminal": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "scroll_up",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Whether to clear the terminal or scroll up before running.",
      "title": "Clear Terminal"
    },
    "show_time_took": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Whether to display the execution duration at footer",
      "title": "Show Time Took"
    },
    "show_command": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Whether to display the command in footer.",
      "title": "Show Command"
    },
    "show_divider": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Whether to print the separation line before the footer",
      "title": "Show Divider"
    },
    "cache_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Custom directory used for cache and compiled build artifacts.",
      "title": "Cache Dir"
    },
    "cd_to_file_dir": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Whether to change the working directory to the target file's folder before running/compiling.",
      "title": "Cd To File Dir"
    },
    "keep_build_artifacts": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Whether to retain temporary or compiled binaries after execution completes.",
      "title": "Keep Build Artifacts"
    },
    "auto_exit": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutoExit"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Controls automatic process exit behavior."
    },
    "commands": {
      "anyOf": [
        {
          "$ref": "#/$defs/CmdConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Custom language templates."
    }
  },
  "type": "object"
}
