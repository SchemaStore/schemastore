{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/mikrotik-mcp.json",
  "$comment": "Derived from MikrotikConfigSchema (Zod input, draft-7) in https://github.com/mikrotik-mcp/mikrotik-mcp/blob/925f11ee62fa17a02f84b8c6dc4bc9455972dd35/src/config.ts. Resolved object defaults and host-specific paths are omitted. Supports structured configuration and legacy bare device maps.",
  "title": "MikroTik MCP configuration",
  "description": "Configuration for @usex/mikrotik-mcp. Use the structured devices form when including $schema or server settings.\nhttps://mikrotik-mcp.usestrict.dev/docs/guides/configuration",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "format": "uri",
          "description": "JSON Schema used by editors to validate this configuration."
        },
        "serviceProbes": {
          "type": "object",
          "properties": {
            "scheduled": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              }
            },
            "targets": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z\\d_-]{1,64}$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["dns", "tcp", "tls", "https"]
                  },
                  "host": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z\\d](?:[a-z\\d.-]*[a-z\\d])?$"
                  },
                  "port": {
                    "default": 443,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "path": {
                    "default": "/health",
                    "type": "string",
                    "maxLength": 1024
                  },
                  "addresses": {
                    "minItems": 1,
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["kind", "host", "addresses"]
              }
            },
            "timeoutMs": {
              "default": 5000,
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            }
          },
          "description": "Approved service probe targets and scheduled checks."
        },
        "devices": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/definitions/device"
          },
          "description": "Named routers and their management connection settings."
        },
        "defaultDevice": {
          "default": "default",
          "type": "string",
          "description": "Name of the router used when a tool call does not specify a device."
        },
        "mcp": {
          "type": "object",
          "properties": {
            "transport": {
              "default": "stdio",
              "type": "string",
              "enum": ["stdio", "sse", "streamable-http"]
            },
            "host": {
              "default": "0.0.0.0",
              "type": "string"
            },
            "port": {
              "default": 8000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "allowedHosts": {
              "default": "",
              "type": "string"
            },
            "allowedOrigins": {
              "default": "",
              "type": "string"
            },
            "corsOrigins": {
              "default": "",
              "type": "string"
            },
            "toolPageSize": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "appViews": {
              "default": false,
              "type": "boolean"
            },
            "capabilityGating": {
              "default": "annotate",
              "type": "string",
              "enum": ["off", "annotate", "filter"]
            }
          },
          "description": "MCP transport, listening address and client access settings."
        },
        "s3": {
          "type": "object",
          "properties": {
            "accessKeyId": {
              "type": "string"
            },
            "secretAccessKey": {
              "type": "string"
            },
            "sessionToken": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "default": "",
              "type": "string"
            },
            "presignExpiresIn": {
              "default": 3600,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "dashboard": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "host": {
              "default": "0.0.0.0",
              "type": "string"
            },
            "port": {
              "default": 9090,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "dbPath": {
              "type": "string"
            },
            "maxEvents": {
              "default": 100000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "captureBody": {
              "default": true,
              "type": "boolean"
            },
            "redactInput": {
              "default": false,
              "type": "boolean"
            },
            "maxBodyBytes": {
              "default": 16384,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "token": {
              "type": "string"
            },
            "feedLimit": {
              "default": 200,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 10000
            }
          },
          "description": "Optional local observability dashboard and storage settings."
        },
        "alerts": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {}
            },
            "channels": {
              "type": "object",
              "properties": {
                "slack": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": ["url"]
                },
                "discord": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": ["url"]
                },
                "ntfy": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "token": {
                      "type": "string"
                    }
                  },
                  "required": ["url"]
                },
                "webhook": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "method": {
                      "type": "string"
                    },
                    "headers": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["url"]
                },
                "mcp": {
                  "type": "object",
                  "properties": {}
                }
              }
            },
            "maxHistory": {
              "default": 5000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "flows": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "port": {
              "default": 2055,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "db": {
              "type": "string"
            },
            "retentionHours": {
              "default": 24,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "rollupDays": {
              "default": 30,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxRows": {
              "default": 2000000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "policy": {
          "type": "object",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "includeStarterPack": {
              "default": true,
              "type": "boolean"
            }
          }
        },
        "schedules": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "jobs": {
              "type": "array",
              "items": {}
            },
            "concurrency": {
              "default": 4,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 64
            },
            "timeoutMs": {
              "default": 600000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "jitterMs": {
              "default": 3000,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tickSeconds": {
              "default": 30,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "retainDays": {
              "default": 90,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "attacks": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "mode": {
              "default": "detect",
              "type": "string",
              "enum": ["detect", "respond"]
            },
            "pollSeconds": {
              "default": 120,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "windowMinutes": {
              "default": 10,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "concurrency": {
              "default": 4,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 32
            },
            "minConfidence": {
              "default": "high",
              "type": "string",
              "enum": ["medium", "high", "confirmed"]
            },
            "blockTimeout": {
              "default": "1h",
              "type": "string"
            },
            "maxBlocksPerHour": {
              "default": 6,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "neverBlock": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "autoRespondTo": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "learningDays": {
              "default": 7,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "readScanList": {
              "default": true,
              "type": "boolean"
            },
            "retainDays": {
              "default": 90,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "ssh": {
          "type": "object",
          "properties": {
            "keepAlive": {
              "default": true,
              "type": "boolean"
            },
            "keepAliveInterval": {
              "default": 10000,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "idleTimeout": {
              "default": 30000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "description": "SSH connection pool settings."
        },
        "readOnly": {
          "default": false,
          "type": "boolean",
          "description": "Expose only read-only tools when enabled."
        },
        "access": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "maxRisk": {
              "type": "string",
              "enum": [
                "READ",
                "WRITE",
                "WRITE_IDEMPOTENT",
                "DESTRUCTIVE",
                "DANGEROUS"
              ]
            },
            "devices": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyDevices": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyTools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "label": {
              "type": "string"
            }
          }
        },
        "tools": {
          "type": "object",
          "properties": {
            "enabledModules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disabledModules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enabledGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disabledGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Limit the tools and modules exposed to MCP clients."
        },
        "memory": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "dbPath": {
              "type": "string"
            }
          },
          "description": "Persistent network knowledge and memory settings."
        },
        "backupDir": {
          "type": "string"
        },
        "disableUpdateCheck": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": ["devices"]
    },
    {
      "type": "object",
      "not": {
        "required": ["devices"]
      },
      "additionalProperties": {
        "$ref": "#/definitions/device"
      }
    }
  ],
  "definitions": {
    "device": {
      "type": "object",
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "type": "string"
        },
        "fallbackHosts": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "format": "ipv4",
                "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
              },
              {
                "type": "string",
                "format": "ipv6",
                "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
              }
            ]
          }
        },
        "username": {
          "default": "admin",
          "type": "string"
        },
        "password": {
          "default": "",
          "type": "string"
        },
        "bandwidthAuth": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": ["username", "password"]
        },
        "port": {
          "default": 22,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "keyFilename": {
          "type": "string"
        },
        "privateKey": {
          "type": "string"
        },
        "keyPassphrase": {
          "type": "string"
        },
        "timeoutMs": {
          "default": 10000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "jumpVia": {
          "type": "string"
        },
        "jumpHost": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "default": 22,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "username": {
              "default": "admin",
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "keyFilename": {
              "type": "string"
            },
            "privateKey": {
              "type": "string"
            },
            "keyPassphrase": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["host"]
        },
        "mac": {
          "type": "string"
        },
        "sourceMac": {
          "type": "string"
        },
        "macHost": {
          "type": "string"
        },
        "macPort": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "api": {
          "type": "boolean"
        },
        "apiPort": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "apiInsecureTls": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "type": "boolean"
        }
      }
    }
  }
}
