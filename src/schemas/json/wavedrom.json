{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/wavedrom.json",
  "$comment": "Generated by wavedrom-schema v0.4.0 https://github.com/wavedrom/schema",
  "title": "WaveDrom",
  "description": "WaveJSON: WaveDrom timing diagram, bit-field (register), or logic circuit description\nhttps://wavedrom.com",
  "definitions": {
    "textNode": {
      "type": "object",
      "description": "Header / footer of the timing diagram",
      "properties": {
        "text": {
          "$ref": "#/definitions/textSpan",
          "description": "Title text, plain string or JsonML (SVG tspan) markup"
        },
        "tick": {
          "type": "number",
          "description": "Draw tick marks with cycle numbers aligned to the clock edges, starting from this number"
        },
        "tock": {
          "type": "number",
          "description": "Draw tock marks with cycle numbers placed between clock edges, starting from this number"
        },
        "every": {
          "type": "integer",
          "minimum": 1,
          "description": "Show only every N-th tick / tock label"
        }
      }
    },
    "textSpan": {
      "description": "Text as plain string or JsonML (SVG tspan) markup, e.g. [\"tspan\", {\"class\": \"h1\"}, \"Title\"]",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array"
        }
      ]
    },
    "waveLane": {
      "type": "object",
      "title": "wave lane",
      "description": "Signal descriptor. Empty object {} creates a gap between lanes.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Signal label"
        },
        "wave": {
          "description": "Signal activity. One character per cycle: p n P N h l H L 0 1 = 2-9 x z u d . |",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "description": "Piece-wise analog wave description, e.g. [\"pw\", {\"d\": \"m0,0 l1,1\"}]"
            }
          ]
        },
        "data": {
          "description": "Labels for data (value) cycles: array of strings, or a single space-separated string",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "array"
                  }
                ]
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "period": {
          "type": "number",
          "description": "Signal period (multiplier of a cycle width)",
          "exclusiveMinimum": 0
        },
        "phase": {
          "type": "number",
          "description": "Phase shift in cycles. Positive number represents shift into the future. Negative number represents shift into past (delay)."
        },
        "node": {
          "type": "string",
          "description": "Named nodes used by edge arrows, one character per cycle: \".\" no marker, [A-Z] invisible marker, other characters visible marker"
        },
        "over": {
          "type": "string",
          "description": "Colored line above the lane, one character per cycle"
        },
        "under": {
          "type": "string",
          "description": "Colored line below the lane, one character per cycle"
        }
      }
    },
    "waveGroup": {
      "type": "array",
      "title": "wave group",
      "description": "Group of wave lanes. Optional first string element is the group label. Groups can be nested.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/definitions/waveLane"
          },
          {
            "$ref": "#/definitions/waveGroup"
          }
        ]
      }
    },
    "signal": {
      "type": "object",
      "title": "timing diagram",
      "description": "WaveDrom digital timing diagram\nhttps://wavedrom.com/tutorial.html",
      "required": ["signal"],
      "properties": {
        "signal": {
          "type": "array",
          "description": "List of wave lanes and wave groups",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/waveLane"
              },
              {
                "$ref": "#/definitions/waveGroup"
              }
            ]
          }
        },
        "head": {
          "$ref": "#/definitions/textNode",
          "description": "Diagram header"
        },
        "foot": {
          "$ref": "#/definitions/textNode",
          "description": "Diagram footer"
        },
        "edge": {
          "type": "array",
          "description": "Arrows between nodes, e.g. \"a~>b label\"",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "object",
          "description": "Rendering options",
          "properties": {
            "hscale": {
              "type": "number",
              "minimum": 1,
              "description": "Horizontal scale (integer number of bricks per cycle)"
            },
            "skin": {
              "description": "Skin name",
              "anyOf": [
                {
                  "enum": [
                    "default",
                    "narrow",
                    "narrower",
                    "narrowerer",
                    "lowkey",
                    "dark"
                  ]
                },
                {
                  "type": "string"
                }
              ]
            },
            "hbounds": {
              "type": "array",
              "description": "Horizontal bounds [min, max] in cycles",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "marks": {
              "type": "boolean",
              "description": "Draw vertical cycle marks",
              "default": true
            },
            "arcFontSize": {
              "type": "number",
              "description": "Font size of edge (arc) labels"
            }
          }
        }
      }
    },
    "assign": {
      "type": "object",
      "title": "logic circuit",
      "description": "WaveDrom logic circuit (schematic) diagram\nhttps://wavedrom.com/tutorial2.html",
      "required": ["assign"],
      "properties": {
        "assign": {
          "type": "array",
          "description": "List of assignments: [\"out\", expression] where expression is a nested array tree [\"&\", \"a\", [\"~\", \"b\"]]",
          "items": {
            "type": "array"
          }
        }
      }
    },
    "reg": {
      "type": "object",
      "title": "register",
      "description": "WaveDrom bit-field (register) diagram\nhttps://github.com/wavedrom/bitfield",
      "required": ["reg"],
      "properties": {
        "reg": {
          "type": "array",
          "description": "List of bit fields, starting from LSB",
          "items": {
            "type": "object",
            "properties": {
              "bits": {
                "type": "integer",
                "minimum": 1,
                "description": "Field width in bits"
              },
              "name": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ],
                "description": "Field name"
              },
              "attr": {
                "description": "Field attribute(s), rendered below the field. Number is rendered as binary.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  }
                ]
              },
              "type": {
                "type": "integer",
                "minimum": 0,
                "description": "Field color type"
              },
              "rotate": {
                "type": "number",
                "description": "Rotation angle of the field name (degrees)"
              }
            }
          }
        },
        "config": {
          "type": "object",
          "description": "Rendering options",
          "properties": {
            "hspace": {
              "type": "number",
              "description": "Horizontal space",
              "default": 640
            },
            "vspace": {
              "type": "number",
              "description": "Vertical space",
              "default": 80
            },
            "lanes": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of rectangle lanes",
              "default": 1
            },
            "bits": {
              "type": "integer",
              "minimum": 1,
              "description": "Overall bit width"
            },
            "fontsize": {
              "type": "number",
              "description": "Font size",
              "default": 14
            },
            "fontfamily": {
              "type": "string",
              "description": "Font family",
              "default": "sans-serif"
            },
            "fontweight": {
              "type": "string",
              "description": "Font weight",
              "default": "normal"
            },
            "compact": {
              "type": "boolean",
              "description": "Compact format",
              "default": false
            },
            "hflip": {
              "type": "boolean",
              "description": "Horizontal flip",
              "default": false
            },
            "vflip": {
              "type": "boolean",
              "description": "Vertical flip",
              "default": false
            },
            "uneven": {
              "type": "boolean",
              "description": "Uneven lanes",
              "default": false
            },
            "trim": {
              "type": "number",
              "description": "Trim long names to this character width"
            },
            "offset": {
              "type": "number",
              "description": "Offset of the index lanes"
            },
            "margin": {
              "type": "object",
              "description": "Margins around the diagram",
              "properties": {
                "top": {
                  "type": "number",
                  "description": "Top margin"
                },
                "right": {
                  "type": "number",
                  "description": "Right margin"
                },
                "bottom": {
                  "type": "number",
                  "description": "Bottom margin"
                },
                "left": {
                  "type": "number",
                  "description": "Left margin"
                }
              }
            },
            "label": {
              "type": "object",
              "description": "Lane labels on the left / right side"
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/definitions/signal"
    },
    {
      "$ref": "#/definitions/assign"
    },
    {
      "$ref": "#/definitions/reg"
    }
  ]
}
