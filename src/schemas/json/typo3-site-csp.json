{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/typo3-site-csp.json",
  "title": "TYPO3 site Content-Security-Policy",
  "description": "Content-Security-Policy of a site in config/sites/<identifier>/csp.yaml.",
  "type": ["object", "null"],
  "additionalProperties": false,
  "properties": {
    "imports": {
      "$ref": "https://www.schemastore.org/partial-typo3-imports.json"
    },
    "active": {
      "description": "Enables the policy.",
      "type": "boolean",
      "default": true
    },
    "inheritDefault": {
      "description": "Starts from the policy of core and extensions.",
      "type": "boolean",
      "default": true
    },
    "mutations": {
      "description": "Changes to the policy.",
      "type": ["array", "object"],
      "items": {
        "$ref": "#/definitions/mutation"
      },
      "additionalProperties": {
        "$ref": "#/definitions/mutation"
      }
    },
    "enforce": {
      "description": "Sends the Content-Security-Policy header.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/definitions/disposition"
        }
      ]
    },
    "report": {
      "description": "Sends the Content-Security-Policy-Report-Only header.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/definitions/disposition"
        }
      ]
    },
    "behavior": {
      "description": "How inline scripts and styles are allowed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "useNonce": {
          "description": "Allows inline scripts and styles with a nonce value.",
          "type": "boolean"
        },
        "useHash": {
          "description": "Allows inline scripts and styles with a hash value.",
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inheritDefault": {
          "description": "Starts from the policy of core and extensions.",
          "type": "boolean",
          "default": true
        },
        "includeResolutions": {
          "description": "Applies resolutions of reported violations.",
          "type": "boolean",
          "default": true
        },
        "reportingUrl": {
          "description": "Where violations are reported.",
          "type": ["string", "boolean", "null"]
        },
        "mutations": {
          "description": "Changes to the policy.",
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/mutation"
          },
          "additionalProperties": {
            "$ref": "#/definitions/mutation"
          }
        },
        "packages": {
          "description": "Packages whose policies are used, for example \"typo3/cms-core: true\".",
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "required": ["mode", "directive"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "How the sources are applied to the directive.",
          "enum": [
            "set",
            "append",
            "inherit-once",
            "inherit-again",
            "extend",
            "reduce",
            "remove"
          ]
        },
        "directive": {
          "description": "Directive to change.",
          "enum": [
            "default-src",
            "base-uri",
            "child-src",
            "connect-src",
            "font-src",
            "form-action",
            "frame-ancestors",
            "frame-src",
            "img-src",
            "manifest-src",
            "media-src",
            "object-src",
            "plugin-types",
            "report-to",
            "report-uri",
            "require-trusted-types-for",
            "sandbox",
            "script-src",
            "script-src-attr",
            "script-src-elem",
            "style-src",
            "style-src-attr",
            "style-src-elem",
            "trusted-types",
            "upgrade-insecure-requests",
            "worker-src"
          ]
        },
        "sources": {
          "description": "Sources like \"'self'\" or \"data:\".",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "'none'",
                  "'self'",
                  "'unsafe-inline'",
                  "'unsafe-eval'",
                  "'unsafe-hashes'",
                  "'wasm-unsafe-eval'",
                  "'report-sample'",
                  "'strict-dynamic'",
                  "'nonce-proxy'"
                ]
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    }
  }
}
