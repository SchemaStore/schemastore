{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/typo3-form-config.json",
  "title": "TYPO3 form configuration",
  "description": "Form set in Configuration/Form/<SetFolder>/config.yaml.",
  "type": "object",
  "properties": {
    "imports": {
      "description": "Other YAML files to include.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource"],
        "additionalProperties": false,
        "properties": {
          "resource": {
            "description": "Absolute, relative or \"EXT:\" path of the file.",
            "type": "string",
            "examples": ["EXT:my_extension/Configuration/Routes/Default.yaml"]
          },
          "glob": {
            "description": "Treats resource as a pattern like \"*.yaml\".",
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "name": {
      "description": "Unique name like \"my-vendor/my-form-set\".",
      "type": "string",
      "examples": ["my-vendor/my-form-set"]
    },
    "label": {
      "description": "Label shown in diagnostic output.",
      "type": "string"
    },
    "priority": {
      "description": "Lower priorities are loaded first.",
      "type": "integer",
      "default": 100
    },
    "persistenceManager": {
      "description": "Where forms are stored.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedFileMounts": {
          "description": "Deprecated.",
          "type": ["object", "array"],
          "items": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "allowedExtensionPaths": {
          "description": "Extension paths to load forms from, for example \"EXT:my_extension/Resources/Private/Forms/\".",
          "type": ["object", "array"],
          "items": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "allowSaveToExtensionPaths": {
          "description": "Allows saving forms in extension paths.",
          "type": "boolean",
          "default": false
        },
        "allowDeleteFromExtensionPaths": {
          "description": "Allows deleting forms in extension paths.",
          "type": "boolean",
          "default": false
        },
        "sortByKeys": {
          "description": "Sort keys in the form manager.",
          "type": ["object", "array"],
          "items": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "sortAscending": {
          "description": "Sorts ascending in the form manager.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "prototypes": {
      "description": "Prototypes, keyed by name.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "formElementsDefinition": {
            "description": "Form element types, keyed by type.",
            "type": "object",
            "additionalProperties": {
              "type": ["object", "null"],
              "properties": {
                "implementationClassName": {
                  "description": "Class implementing the element.",
                  "type": "string"
                },
                "properties": {
                  "description": "Default properties of the element.",
                  "type": "object"
                },
                "renderingOptions": {
                  "description": "Default rendering options of the element.",
                  "type": "object"
                },
                "formEditor": {
                  "description": "Configuration of the element in the form editor.",
                  "type": "object"
                },
                "validators": {
                  "description": "Validators added to every element of this type.",
                  "type": "array"
                },
                "variants": {
                  "description": "Variants added to every element of this type.",
                  "type": "array"
                }
              }
            }
          },
          "finishersDefinition": {
            "description": "Finishers, keyed by identifier.",
            "type": "object",
            "additionalProperties": {
              "type": ["object", "null"],
              "properties": {
                "implementationClassName": {
                  "description": "Class implementing the finisher.",
                  "type": "string"
                },
                "options": {
                  "description": "Default options of the finisher.",
                  "type": "object"
                },
                "formEditor": {
                  "description": "Configuration of the finisher in the form editor.",
                  "type": "object"
                },
                "FormEngine": {
                  "description": "Configuration of the finisher in the form plugin.",
                  "type": "object"
                }
              }
            }
          },
          "validatorsDefinition": {
            "description": "Validators, keyed by identifier.",
            "type": "object",
            "additionalProperties": {
              "type": ["object", "null"],
              "properties": {
                "implementationClassName": {
                  "description": "Class implementing the validator.",
                  "type": "string"
                },
                "options": {
                  "description": "Default options of the validator.",
                  "type": "object"
                },
                "formEditor": {
                  "description": "Configuration of the validator in the form editor.",
                  "type": "object"
                }
              }
            }
          },
          "formEditor": {
            "description": "Configuration of the form editor.",
            "type": "object"
          },
          "formEngine": {
            "description": "Configuration of the form plugin in the backend.",
            "type": "object"
          }
        }
      }
    },
    "formManager": {
      "description": "Configuration of the form manager backend module.",
      "type": "object"
    }
  }
}
