{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/tracks.json",
  "$comment": "Tracks Schema - Knowledge base format for AI agents (replacement for tracks.json)",
  "type": "object",
  "description": "Tracks are Markdown-based knowledge modules for AI agents. They provide context, instructions, and capabilities to AI systems.",
  "required": ["name", "version"],
  "properties": {
    "$schema": {
      "description": "JSON Schema reference for editor autocomplete/validation",
      "type": "string"
    },
    "name": {
      "description": "Unique track identifier",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "version": {
      "description": "Semantic version (e.g., 1.0.0)",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$"
    },
    "description": {
      "description": "Brief description of what this track provides",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "author": {
      "description": "Track author information",
      "type": "object",
      "properties": {
        "name": {
          "description": "Author name",
          "type": "string",
          "minLength": 1
        },
        "email": {
          "description": "Author email",
          "type": "string",
          "format": "email"
        },
        "url": {
          "description": "Author website or GitHub profile",
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["name"]
    },
    "license": {
      "description": "SPDX license identifier",
      "type": "string"
    },
    "homepage": {
      "description": "Track homepage or documentation URL",
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "description": "Source code repository URL",
      "type": "string"
    },
    "type": {
      "description": "Track type",
      "type": "string",
      "enum": [
        "knowledge",
        "instruction",
        "capability",
        "workflow",
        "integration",
        "template"
      ],
      "default": "knowledge"
    },
    "category": {
      "description": "Track category for organization",
      "type": "string",
      "enum": [
        "programming",
        "documentation",
        "data-science",
        "devops",
        "security",
        "ai-ml",
        "web",
        "mobile",
        "cloud",
        "database",
        "testing",
        "productivity",
        "communication",
        "other"
      ]
    },
    "tags": {
      "description": "Tags for discovery and categorization",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "maxItems": 20
    },
    "files": {
      "description": "Files included in this track",
      "type": "object",
      "properties": {
        "main": {
          "description": "Main entry point file (TRACK.md)",
          "type": "string",
          "default": "TRACK.md"
        },
        "readme": {
          "description": "README file path",
          "type": "string",
          "default": "README.md"
        },
        "context": {
          "description": "Context/instructions file for AI",
          "type": "string"
        },
        "examples": {
          "description": "Example files directory",
          "type": "string"
        },
        "assets": {
          "description": "Asset files directory",
          "type": "string"
        }
      }
    },
    "dependencies": {
      "description": "Other tracks required by this track",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Track name",
            "type": "string",
            "minLength": 1
          },
          "version": {
            "description": "Version constraint (semver range)",
            "type": "string"
          },
          "optional": {
            "description": "Whether this dependency is optional",
            "type": "boolean",
            "default": false
          }
        },
        "required": ["name"]
      }
    },
    "triggers": {
      "description": "Patterns that trigger this track to be loaded",
      "type": "object",
      "properties": {
        "filePatterns": {
          "description": "File patterns that trigger this track",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "description": "Keywords that trigger this track",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "description": "Programming languages that trigger this track",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworks": {
          "description": "Frameworks that trigger this track",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "description": "Tools provided by this track",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Tool name",
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "Tool description",
            "type": "string"
          },
          "command": {
            "description": "Shell command to execute",
            "type": "string"
          },
          "script": {
            "description": "Script file path",
            "type": "string"
          }
        },
        "required": ["name", "description"]
      }
    },
    "prompts": {
      "description": "Prompt templates provided by this track",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Prompt name",
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "Prompt description",
            "type": "string"
          },
          "template": {
            "description": "Prompt template with {{variable}} placeholders",
            "type": "string"
          },
          "variables": {
            "description": "Template variables",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "description": "Variable name",
                  "type": "string"
                },
                "description": {
                  "description": "Variable description",
                  "type": "string"
                },
                "required": {
                  "description": "Whether variable is required",
                  "type": "boolean",
                  "default": true
                },
                "default": {
                  "description": "Default value",
                  "type": "string"
                }
              },
              "required": ["name"]
            }
          }
        },
        "required": ["name", "description", "template"]
      }
    },
    "metadata": {
      "description": "Additional metadata",
      "type": "object",
      "properties": {
        "created": {
          "description": "Creation date (ISO 8601)",
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "description": "Last update date (ISO 8601)",
          "type": "string",
          "format": "date-time"
        },
        "downloads": {
          "description": "Download count",
          "type": "integer",
          "minimum": 0
        },
        "rating": {
          "description": "Average rating (0-5)",
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  },
  "additionalProperties": false
}
