{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/partial-typo3-imports.json",
  "title": "TYPO3 YAML imports",
  "description": "Other YAML files to include.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["resource"],
    "additionalProperties": false,
    "properties": {
      "resource": {
        "description": "Absolute, relative or \"EXT:\" path of the file.",
        "type": "string",
        "examples": ["EXT:my_extension/Configuration/Routes/Default.yaml"]
      },
      "glob": {
        "description": "Treats resource as a pattern like \"*.yaml\".",
        "type": "boolean",
        "default": false
      }
    }
  }
}
