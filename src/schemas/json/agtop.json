{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/agtop.json",
  "title": "agtop configuration",
  "description": "Configuration for agtop, a terminal user interface for managing AI coding agent workflows.\nhttps://github.com/justinpbarnett/agtop#configuration",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "root": { "type": "string" },
        "worktree_path": { "type": "string" },
        "repos": { "$ref": "#/definitions/stringArray" },
        "test_command": { "type": "string" },
        "ignore_skill_sources": { "$ref": "#/definitions/stringArray" },
        "dev_server": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "command": { "type": "string" },
            "port_strategy": {
              "type": "string",
              "enum": ["hash", "sequential", "fixed"]
            },
            "base_port": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "path"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "default": {
          "type": "string",
          "enum": ["claude", "opencode"]
        },
        "claude": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "model": { "type": "string" },
            "permission_mode": {
              "type": "string",
              "enum": ["acceptEdits", "acceptAll", "manual"]
            },
            "max_turns": {
              "type": "integer",
              "minimum": 1
            },
            "allowed_tools": { "$ref": "#/definitions/stringArray" },
            "subscription": { "type": "boolean" }
          }
        },
        "opencode": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "model": { "type": "string" },
            "agent": { "type": "string" }
          }
        }
      }
    },
    "workflows": {
      "description": "Workflow definitions keyed by workflow name. Values can be workflow tables or shorthand skill arrays.",
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/definitions/workflow" },
          { "$ref": "#/definitions/stringArray" }
        ]
      }
    },
    "skills": {
      "description": "Skill definitions keyed by skill name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/skill"
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "blocked_patterns": { "$ref": "#/definitions/stringArray" },
        "allow_overrides": { "type": "boolean" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "max_tokens_per_run": { "$ref": "#/definitions/positiveInteger" },
        "max_cost_per_run": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_concurrent_runs": { "$ref": "#/definitions/positiveInteger" },
        "rate_limit_backoff": {
          "type": "integer",
          "minimum": 0
        },
        "rate_limit_max_retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "target_branch": { "type": "string" },
        "auto_merge": { "type": "boolean" },
        "merge_strategy": {
          "type": "string",
          "enum": ["squash", "merge", "rebase"]
        },
        "fix_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "poll_interval": {
          "type": "integer",
          "minimum": 0
        },
        "poll_timeout": {
          "type": "integer",
          "minimum": 0
        },
        "golden_update_command": { "type": "string" },
        "conflict_resolution_attempts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "theme": { "type": "string" },
        "show_token_count": { "type": "boolean" },
        "show_cost": { "type": "boolean" },
        "log_scroll_speed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "auto_check": { "type": "boolean" },
        "repo": {
          "description": "GitHub repository in owner/name form.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "jira": {
          "type": "object",
          "additionalProperties": true,
          "required": ["base_url", "project_key", "auth_env", "user_env"],
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1
            },
            "project_key": {
              "type": "string",
              "minLength": 1
            },
            "auth_env": {
              "type": "string",
              "minLength": 1
            },
            "user_env": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "definitions": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "skills": { "$ref": "#/definitions/stringArray" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model": { "type": "string" },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "parallel": { "type": "boolean" },
        "allowed_tools": { "$ref": "#/definitions/stringArray" },
        "ignore": { "type": "boolean" }
      }
    }
  }
}
