{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/typo3-set-config.json",
  "title": "TYPO3 site set configuration",
  "description": "Site set in Configuration/Sets/<SetFolder>/config.yaml.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "Unique name like \"my-vendor/my-set\".",
      "type": "string",
      "examples": ["my-vendor/my-set"]
    },
    "label": {
      "description": "Label in the backend.",
      "type": "string"
    },
    "labels": {
      "description": "Labels file of the set.",
      "type": "string",
      "examples": ["EXT:my_extension/Configuration/Sets/MySet/labels.xlf"]
    },
    "dependencies": {
      "description": "Sets loaded before this set.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optionalDependencies": {
      "description": "Like dependencies, but missing sets are ignored.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden": {
      "description": "Hides the set in the backend.",
      "type": "boolean",
      "default": false
    },
    "typoscript": {
      "description": "Folder with setup.typoscript and constants.typoscript.",
      "type": ["string", "null"]
    },
    "pagets": {
      "description": "Page TSconfig file.",
      "type": ["string", "null"]
    }
  }
}
