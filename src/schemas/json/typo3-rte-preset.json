{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/typo3-rte-preset.json",
  "title": "TYPO3 CKEditor preset",
  "description": "Rich text editor preset in Configuration/RTE/<Name>.yaml.",
  "type": ["object", "null"],
  "properties": {
    "imports": {
      "description": "Other YAML files to include.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource"],
        "additionalProperties": false,
        "properties": {
          "resource": {
            "description": "Absolute, relative or \"EXT:\" path of the file.",
            "type": "string",
            "examples": ["EXT:my_extension/Configuration/Routes/Default.yaml"]
          },
          "glob": {
            "description": "Treats resource as a pattern like \"*.yaml\".",
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "editor": {
      "description": "Configuration of the editor.",
      "type": "object",
      "properties": {
        "config": {
          "description": "Configuration for CKEditor 5, see https://ckeditor.com/docs/ckeditor5/latest/features/index.html.",
          "type": "object",
          "properties": {
            "toolbar": {
              "description": "Toolbar of the editor.",
              "type": "object",
              "properties": {
                "items": {
                  "description": "Toolbar buttons, \"|\" adds a separator.",
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/toolbarItem"
                  }
                },
                "shouldNotGroupWhenFull": {
                  "description": "Wraps the toolbar if it is too small.",
                  "type": "boolean"
                }
              }
            },
            "importModules": {
              "description": "Additional plugins.",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": ["module"],
                    "additionalProperties": false,
                    "properties": {
                      "module": {
                        "description": "JavaScript module, for example \"@my-vendor/my-extension/my-plugin.js\".",
                        "type": "string"
                      },
                      "exports": {
                        "description": "Plugins exported by the module.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "removeImportModules": {
              "description": "Plugins to remove.",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": ["module"],
                    "additionalProperties": false,
                    "properties": {
                      "module": {
                        "description": "JavaScript module, for example \"@my-vendor/my-extension/my-plugin.js\".",
                        "type": "string"
                      },
                      "exports": {
                        "description": "Plugins exported by the module.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "contentsCss": {
              "description": "Stylesheets inside the editor, for example \"EXT:my_extension/Resources/Public/Css/rte.css\".",
              "type": ["array", "string"],
              "items": {
                "type": "string"
              }
            },
            "width": {
              "description": "Width of the editor, for example \"auto\" or 600.",
              "type": ["string", "number"]
            },
            "height": {
              "description": "Height of the editor, for example 300.",
              "type": ["string", "number"]
            },
            "readOnly": {
              "description": "Makes the content read-only.",
              "type": "boolean"
            },
            "debug": {
              "description": "Loads the CKEditor 5 inspector.",
              "type": "boolean"
            }
          }
        },
        "externalPlugins": {
          "description": "Options of TYPO3 plugins, keyed by plugin name.",
          "type": "object"
        }
      }
    },
    "processing": {
      "description": "Transformations between editor and database.",
      "type": "object",
      "properties": {
        "mode": {
          "description": "Transformations to apply.",
          "type": "string",
          "default": "default"
        },
        "overruleMode": {
          "description": "Comma separated transformations, replaces mode.",
          "type": "string"
        },
        "allowTags": {
          "description": "Tags kept when saving.",
          "type": ["array", "string"],
          "items": {
            "type": "string"
          }
        },
        "allowTagsOutside": {
          "description": "Tags allowed outside of paragraphs.",
          "type": ["array", "string"],
          "items": {
            "type": "string"
          }
        },
        "allowAttributes": {
          "description": "Attributes kept on block elements.",
          "type": ["array", "string"],
          "items": {
            "type": "string"
          }
        },
        "HTMLparser_db": {
          "description": "HTML parser options applied when saving.",
          "type": "object"
        },
        "HTMLparser_rte": {
          "description": "HTML parser options applied when loading.",
          "type": "object"
        },
        "entryHTMLparser_db": {
          "description": "HTML parser options applied before the transformations when saving.",
          "type": "object"
        },
        "exitHTMLparser_db": {
          "description": "HTML parser options applied after the transformations when saving.",
          "type": "object"
        },
        "entryHTMLparser_rte": {
          "description": "HTML parser options applied before the transformations when loading.",
          "type": "object"
        },
        "exitHTMLparser_rte": {
          "description": "HTML parser options applied after the transformations when loading.",
          "type": "object"
        }
      }
    },
    "buttons": {
      "description": "Options of TYPO3 buttons, for example the link browser.",
      "type": "object"
    },
    "classes": {
      "description": "CSS classes for the link browser, keyed by class name.",
      "type": "object"
    },
    "classesAnchor": {
      "description": "CSS classes for links, by link type.",
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "definitions": {
    "toolbarItem": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "description": "Group of toolbar buttons in a dropdown.",
          "type": "object",
          "required": ["label", "items"],
          "properties": {
            "label": {
              "description": "Label of the dropdown.",
              "type": "string"
            },
            "icon": {
              "description": "Icon name like \"threeVerticalDots\", or SVG markup.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "const": false
                }
              ]
            },
            "items": {
              "description": "Toolbar buttons in the dropdown.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/toolbarItem"
              }
            },
            "tooltip": {
              "description": "Tooltip of the dropdown button.",
              "type": ["string", "boolean"]
            },
            "withText": {
              "description": "Shows the label next to the icon.",
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
