{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/haijun-voice.json",
  "$comment": "Haijun Voice Extension Schema - Based on Gemini CLI extensions format for cross-platform AI voice communication",
  "type": "object",
  "description": "Haijun Voice extension manifest for cross-platform AI voice communication. Haijun Voice is an AI voice assistant platform similar to Jarvis.",
  "required": ["name", "version", "description"],
  "properties": {
    "$schema": {
      "description": "JSON Schema reference for editor autocomplete/validation",
      "type": "string"
    },
    "name": {
      "description": "Unique extension name (lowercase, numbers, dashes only)",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "description": "Semantic version (e.g., 1.0.0)",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$"
    },
    "description": {
      "description": "Brief description of the extension",
      "type": "string",
      "minLength": 1
    },
    "author": {
      "description": "Extension author information",
      "type": "object",
      "properties": {
        "name": {
          "description": "Author name",
          "type": "string",
          "minLength": 1
        },
        "email": {
          "description": "Author email",
          "type": "string",
          "format": "email"
        },
        "url": {
          "description": "Author website or GitHub profile",
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["name"]
    },
    "license": {
      "description": "SPDX license identifier",
      "type": "string"
    },
    "homepage": {
      "description": "Extension homepage URL",
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "description": "Source code repository URL",
      "type": "string"
    },
    "platforms": {
      "description": "Supported platforms",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["windows", "macos", "linux", "ios", "android", "web"]
      },
      "minItems": 1
    },
    "languages": {
      "description": "Supported voice input languages (BCP 47 tags)",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,})*$"
      },
      "default": ["en-US", "id-ID"]
    },
    "voiceEngines": {
      "description": "Voice engine configurations",
      "type": "object",
      "properties": {
        "tts": {
          "description": "Text-to-Speech engine configuration",
          "type": "object",
          "properties": {
            "provider": {
              "description": "TTS provider",
              "type": "string",
              "enum": ["google", "azure", "amazon", "custom"]
            },
            "model": {
              "description": "TTS model name",
              "type": "string"
            },
            "voice": {
              "description": "Default voice name",
              "type": "string"
            }
          }
        },
        "stt": {
          "description": "Speech-to-Text engine configuration",
          "type": "object",
          "properties": {
            "provider": {
              "description": "STT provider",
              "type": "string",
              "enum": ["google", "azure", "amazon", "whisper", "custom"]
            },
            "model": {
              "description": "STT model name",
              "type": "string"
            },
            "language": {
              "description": "Default recognition language",
              "type": "string"
            }
          }
        },
        "wakeWord": {
          "description": "Wake word detection configuration",
          "type": "object",
          "properties": {
            "enabled": {
              "description": "Enable wake word detection",
              "type": "boolean",
              "default": true
            },
            "words": {
              "description": "Wake words to listen for",
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": ["Hey Haijun", "Haijun"]
            },
            "sensitivity": {
              "description": "Wake word detection sensitivity (0.0-1.0)",
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          }
        }
      }
    },
    "mcpServers": {
      "description": "MCP servers to include in the extension",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "description": "Command to start the MCP server",
            "type": "string"
          },
          "args": {
            "description": "Arguments for the MCP server command",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "description": "Environment variables for the MCP server",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "cwd": {
            "description": "Working directory for the MCP server",
            "type": "string"
          }
        },
        "required": ["command"]
      }
    },
    "commands": {
      "description": "Voice commands provided by this extension",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Command name",
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "Command description",
            "type": "string"
          },
          "phrases": {
            "description": "Voice phrases that trigger this command",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "handler": {
            "description": "Handler function or script path",
            "type": "string"
          }
        },
        "required": ["name", "description", "phrases"]
      }
    },
    "contextFileName": {
      "description": "Name of the context file (e.g., HAIJUN.md)",
      "type": "string",
      "default": "HAIJUN.md"
    },
    "excludeTools": {
      "description": "Tools to exclude from this extension",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "description": "Extension-specific settings",
      "type": "object",
      "properties": {
        "alwaysListening": {
          "description": "Keep microphone always listening for wake word",
          "type": "boolean",
          "default": false
        },
        "pushToTalk": {
          "description": "Enable push-to-talk mode",
          "type": "boolean",
          "default": false
        },
        "noiseReduction": {
          "description": "Enable noise reduction",
          "type": "boolean",
          "default": true
        },
        "echoCancellation": {
          "description": "Enable echo cancellation",
          "type": "boolean",
          "default": true
        },
        "autoDetectLanguage": {
          "description": "Auto-detect input language",
          "type": "boolean",
          "default": true
        },
        "responseSpeed": {
          "description": "Response speed setting",
          "type": "string",
          "enum": ["fast", "balanced", "accurate"],
          "default": "balanced"
        }
      }
    }
  },
  "additionalProperties": false
}
