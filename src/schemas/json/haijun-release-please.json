{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/haijun-release-please.json",
  "$comment": "Haijun Release Please Config - Adapted from googleapis/release-please for Haijun Ecosystem",
  "title": "HaijunReleasePleaseConfig",
  "description": "Configuration schema for release-please-config.json in Haijun projects. Release Please automates releases and changelogs.\n\nDocumentation: https://github.com/googleapis/release-please\nHaijun Ecosystem: https://tracks.web.id",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema URL for validation.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "packages": {
      "description": "Package-level configuration for release-please.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "release-type": {
                "description": "The release type for this package.",
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "node",
                      "python",
                      "rust",
                      "go",
                      "java",
                      "helm",
                      "typescript",
                      "elixir",
                      "ruby",
                      "godart",
                      "maven",
                      "monorepo"
                    ]
                  },
                  { "type": "null" }
                ]
              },
              "bump-minor-pre-major": {
                "description": "Whether to bump minor version before major version.",
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              },
              "bump-patch-for-minor-pre-major": {
                "description": "Whether to bump patch version for minor pre-major changes.",
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              },
              "changelog-sections": {
                "description": "Sections to include in the changelog.",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": { "type": "string" },
                        "section": { "type": "string" },
                        "hidden": { "type": "boolean" }
                      }
                    }
                  },
                  { "type": "null" }
                ]
              },
              "changelog-path": {
                "description": "Path to the changelog file.",
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              },
              "changelog-title": {
                "description": "Title for the changelog.",
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              },
              "component": {
                "description": "Name of the component for this package.",
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              },
              "draft": {
                "description": "Whether this is a draft release.",
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              },
              "extra-files": {
                "description": "Additional files to update during release.",
                "anyOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "null" }
                ]
              },
              "include-component-in-tag": {
                "description": "Whether to include the component name in the release tag.",
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              },
              "include-v-in-tag": {
                "description": "Whether to include a 'v' prefix in the release tag.",
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              },
              "package-name": {
                "description": "Override the package name for this package.",
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              },
              "path": {
                "description": "The path to the package directory.",
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              },
              "prerelease": {
                "description": "Whether this is a prerelease.",
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              },
              "prerelease-type": {
                "description": "The type of prerelease (alpha, beta, rc).",
                "anyOf": [
                  { "type": "string", "enum": ["alpha", "beta", "rc"] },
                  { "type": "null" }
                ]
              },
              "pull-request-title-pattern": {
                "description": "Pattern for the pull request title.",
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              },
              "separate-pull-requests": {
                "description": "Whether to create separate pull requests for each package.",
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              },
              "signoff": {
                "description": "Whether to sign off commits.",
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              },
              "tag-separator": {
                "description": "Separator between component and version in tag.",
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              },
              "version-file": {
                "description": "Override the version file path.",
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "bootstrap-sha": {
      "description": "SHA of the initial commit for release-please.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "bump-minor-pre-major": {
      "description": "Whether to bump minor version before major version.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "bump-patch-for-minor-pre-major": {
      "description": "Whether to bump patch version for minor pre-major changes.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "changelog-sections": {
      "description": "Sections to include in the changelog.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "section": { "type": "string" },
              "hidden": { "type": "boolean" }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "changelog-path": {
      "description": "Path to the changelog file.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "changelog-title": {
      "description": "Title for the changelog.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "draft": {
      "description": "Whether this is a draft release.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "extra-files": {
      "description": "Additional files to update during release.",
      "anyOf": [
        { "type": "array", "items": { "type": "string" } },
        { "type": "null" }
      ]
    },
    "group-pull-request-title-pattern": {
      "description": "Pattern for the group pull request title.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "include-component-in-tag": {
      "description": "Whether to include the component name in the release tag.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "include-v-in-tag": {
      "description": "Whether to include a 'v' prefix in the release tag.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "pull-request-title-pattern": {
      "description": "Pattern for the pull request title.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "release-type": {
      "description": "Default release type for all packages.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "node",
            "python",
            "rust",
            "go",
            "java",
            "helm",
            "typescript",
            "elixir",
            "ruby",
            "godart",
            "maven",
            "monorepo"
          ]
        },
        { "type": "null" }
      ]
    },
    "separate-pull-requests": {
      "description": "Whether to create separate pull requests for each package.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "sequential-calls": {
      "description": "Whether to make sequential API calls.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "signoff": {
      "description": "Whether to sign off commits.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "tag-separator": {
      "description": "Separator between component and version in tag.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    }
  }
}
