{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/typo3-set-settings-definitions.json",
  "title": "TYPO3 site set settings definitions",
  "description": "Settings of a site set in Configuration/Sets/<SetFolder>/settings.definitions.yaml.",
  "type": "object",
  "required": ["settings"],
  "additionalProperties": false,
  "properties": {
    "settings": {
      "description": "Settings, keyed by identifier like \"my-extension.header.color\".",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/setting"
      }
    },
    "categories": {
      "description": "Categories of settings, keyed by identifier.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/category"
      }
    }
  },
  "definitions": {
    "setting": {
      "type": "object",
      "required": ["type", "default"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Type of the setting.",
          "anyOf": [
            {
              "enum": [
                "bool",
                "color",
                "int",
                "number",
                "page",
                "string",
                "stringlist",
                "text",
                "url"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "default": {
          "description": "Default value."
        },
        "label": {
          "description": "Label in the backend.",
          "type": "string"
        },
        "description": {
          "description": "Description in the backend, Markdown allowed.",
          "type": "string"
        },
        "readonly": {
          "description": "Makes the setting read-only in the backend.",
          "type": "boolean",
          "default": false
        },
        "category": {
          "description": "Category of the setting.",
          "type": "string"
        },
        "tags": {
          "description": "Tags for filtering in the backend.",
          "type": ["array", "object"],
          "items": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "enum": {
          "description": "Allowed values, as list or mapped to labels.",
          "type": ["array", "object"],
          "items": {
            "type": ["string", "integer", "number", "boolean"]
          },
          "additionalProperties": {
            "type": ["string", "null"]
          }
        },
        "options": {
          "description": "Options of the setting type.",
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["string", "text"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": ["string", "integer", "number", "boolean", "null"]
              },
              "options": {
                "$ref": "#/definitions/stringOptions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stringlist"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "description": "List of strings, or a JSON list like '[\"a\", \"b\"]'.",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": ["string", "integer", "number", "boolean", "null"]
                    }
                  },
                  {
                    "type": "string",
                    "pattern": "^\\s*\\["
                  }
                ]
              },
              "options": {
                "$ref": "#/definitions/stringOptions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "int"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "$ref": "#/definitions/integerString"
                  }
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "description": "Minimum value.",
                    "type": "integer"
                  },
                  "max": {
                    "description": "Maximum value.",
                    "type": "integer"
                  },
                  "step": {
                    "description": "Step size.",
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "$ref": "#/definitions/numberString"
                  }
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "description": "Minimum value.",
                    "type": "number"
                  },
                  "max": {
                    "description": "Maximum value.",
                    "type": "number"
                  },
                  "step": {
                    "description": "Step size.",
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "enum": [
                  true,
                  false,
                  0,
                  1,
                  "0",
                  "1",
                  "true",
                  "false",
                  "on",
                  "off",
                  "yes",
                  "no"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "page"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "description": "Page ID.",
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "$ref": "#/definitions/integerString"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "color"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "description": "Color as #rgb, #rrggbb, #rrggbbaa, rgb() or rgba().",
                "type": "string",
                "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(.*\\))$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "url"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": ["string", "null"]
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pattern": {
                    "description": "Regular expression the URL must match.",
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "stringOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "description": "Minimum number of characters.",
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "description": "Maximum number of characters.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "integerString": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "numberString": {
      "type": "string",
      "pattern": "^[+-]?([0-9]+|[0-9]*\\.[0-9]+|[0-9]+\\.[0-9]*)([eE][+-]?[0-9]+)?$"
    },
    "category": {
      "description": "Category of settings.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "Label in the backend.",
          "type": "string"
        },
        "description": {
          "description": "Description in the backend.",
          "type": "string"
        },
        "icon": {
          "description": "Identifier of a registered icon.",
          "type": "string"
        },
        "parent": {
          "description": "Identifier of the parent category.",
          "type": "string"
        }
      }
    }
  }
}
