{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/partial-typo3-route-enhancers.json",
  "title": "TYPO3 route enhancers",
  "description": "Route enhancers, keyed by identifier.",
  "type": ["object", "null"],
  "additionalProperties": {
    "$ref": "#/definitions/enhancer"
  },
  "definitions": {
    "enhancer": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "description": "Type of the enhancer.",
          "anyOf": [
            {
              "enum": ["Simple", "Plugin", "Extbase", "PageType"]
            },
            {
              "type": "string"
            }
          ]
        },
        "limitToPages": {
          "description": "Pages the enhancer is used on, like 13 or 'page[\"doktype\"] == 1'.",
          "type": "array",
          "items": {
            "type": ["integer", "string"]
          }
        },
        "aspects": {
          "description": "Aspects, keyed by argument name.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/aspect"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Simple"
              }
            },
            "required": ["type"]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "limitToPages": true,
              "aspects": true,
              "routePath": {
                "description": "URL path, for example \"/show/{product}\".",
                "type": "string"
              },
              "_arguments": {
                "description": "Maps arguments in routePath to query parameters.",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "defaults": {
                "description": "Default values, which make arguments optional.",
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "integer", "number", "boolean"]
                }
              },
              "requirements": {
                "description": "Regular expressions the arguments must match.",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "static": {
                "description": "Arguments to generate statically.",
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            },
            "required": ["routePath"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Plugin"
              }
            },
            "required": ["type"]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "limitToPages": true,
              "aspects": true,
              "routePath": {
                "description": "URL path, for example \"/page/{page}\".",
                "type": "string"
              },
              "namespace": {
                "description": "Namespace of the plugin parameters, for example \"tx_myplugin\".",
                "type": "string"
              },
              "_arguments": {
                "description": "Maps arguments in routePath to query parameters.",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "defaults": {
                "description": "Default values, which make arguments optional.",
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "integer", "number", "boolean"]
                }
              },
              "requirements": {
                "description": "Regular expressions the arguments must match.",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "static": {
                "description": "Arguments to generate statically.",
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            },
            "required": ["routePath", "namespace"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Extbase"
              }
            },
            "required": ["type"]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "limitToPages": true,
              "aspects": true,
              "extension": {
                "description": "Extension name, for example \"News\".",
                "type": "string"
              },
              "plugin": {
                "description": "Plugin name, for example \"Pi1\".",
                "type": "string"
              },
              "namespace": {
                "description": "Namespace of the plugin parameters.",
                "type": "string"
              },
              "routes": {
                "description": "Routes of the plugin.",
                "type": "array",
                "items": {
                  "$ref": "#/definitions/extbaseRoute"
                }
              },
              "defaultController": {
                "description": "Default controller and action, for example \"News::list\".",
                "type": "string"
              },
              "defaults": {
                "description": "Default values, which make arguments optional.",
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "integer", "number", "boolean"]
                }
              },
              "requirements": {
                "description": "Regular expressions the arguments must match.",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "static": {
                "description": "Arguments to generate statically.",
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "PageType"
              }
            },
            "required": ["type"]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "limitToPages": true,
              "aspects": true,
              "default": {
                "description": "Suffix for the default page type, for example \".html\".",
                "type": "string"
              },
              "index": {
                "description": "File name of the root page.",
                "type": "string"
              },
              "map": {
                "description": "Maps suffixes to page types, for example \"sitemap.xml: 1533906435\".",
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "integer"]
                }
              }
            },
            "required": ["map"]
          }
        }
      ]
    },
    "extbaseRoute": {
      "type": "object",
      "required": ["routePath", "_controller"],
      "additionalProperties": false,
      "properties": {
        "routePath": {
          "description": "URL path, for example \"/detail/{news_title}\".",
          "type": "string"
        },
        "_controller": {
          "description": "Controller and action of the route, for example \"News::detail\".",
          "type": "string"
        },
        "_arguments": {
          "description": "Maps arguments in routePath to plugin arguments.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "aspect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "description": "Type of the aspect.",
          "anyOf": [
            {
              "enum": [
                "LocaleModifier",
                "PersistedAliasMapper",
                "PersistedPatternMapper",
                "StaticRangeMapper",
                "StaticValueMapper"
              ]
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "StaticValueMapper"
              }
            },
            "required": ["type"]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "map": {
                "description": "Maps URL values to argument values.",
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "integer"]
                }
              },
              "localeMap": {
                "description": "Maps per language.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["locale", "map"],
                  "additionalProperties": false,
                  "properties": {
                    "locale": {
                      "description": "Locale pattern, for example \"de_DE.*\".",
                      "type": "string"
                    },
                    "map": {
                      "description": "Maps URL values to argument values.",
                      "type": "object",
                      "additionalProperties": {
                        "type": ["string", "integer"]
                      }
                    }
                  }
                }
              },
              "fallbackValue": {
                "description": "Value if the URL value is unknown.",
                "type": ["string", "integer", "number", "boolean", "null"]
              }
            },
            "required": ["map"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "StaticRangeMapper"
              }
            },
            "required": ["type"]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "start": {
                "description": "First value, for example '1'.",
                "type": "string"
              },
              "end": {
                "description": "Last value, for example '100'.",
                "type": "string"
              }
            },
            "required": ["start", "end"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "PersistedAliasMapper"
              }
            },
            "required": ["type"]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "tableName": {
                "description": "Database table of the records.",
                "type": "string"
              },
              "routeFieldName": {
                "description": "Field with the URL value.",
                "type": "string"
              },
              "routeValuePrefix": {
                "description": "Prefix to remove, for example \"/\".",
                "type": "string",
                "maxLength": 1
              },
              "fallbackValue": {
                "description": "Value if the URL value is unknown.",
                "type": ["string", "integer", "number", "boolean", "null"]
              }
            },
            "required": ["tableName", "routeFieldName"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "PersistedPatternMapper"
              }
            },
            "required": ["type"]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "tableName": {
                "description": "Database table of the records.",
                "type": "string"
              },
              "routeFieldPattern": {
                "description": "Regular expression to parse the URL value.",
                "type": "string"
              },
              "routeFieldResult": {
                "description": "Builds the URL value from fields, for example \"{title}-{uid}\".",
                "type": "string"
              },
              "fallbackValue": {
                "description": "Value if the URL value is unknown.",
                "type": ["string", "integer", "number", "boolean", "null"]
              }
            },
            "required": ["tableName", "routeFieldPattern", "routeFieldResult"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "LocaleModifier"
              }
            },
            "required": ["type"]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "default": {
                "description": "Value used when no locale matches.",
                "type": "string"
              },
              "localeMap": {
                "description": "Values per language.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["locale", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "locale": {
                      "description": "Locale pattern, for example \"de_DE.*\".",
                      "type": "string"
                    },
                    "value": {
                      "description": "Value used for this locale.",
                      "type": ["string", "integer"]
                    }
                  }
                }
              }
            },
            "required": ["localeMap"]
          }
        }
      ]
    }
  }
}
