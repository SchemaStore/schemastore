{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemastore.org",
    "type": "object",
    "properties": {
        "projects": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    }
                },
                "required": ["id", "path"]
            }
        },
        "configurations": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "target": {
                        "type": "string",
                        "enum": ["Release", "Debug"]
                    },
                    "compiler_path": {
                        "type": "string"
                    }
                },
                "required": ["id", "target"]
            }
        }
    },
    "required": ["projects", "configurations"]
}
