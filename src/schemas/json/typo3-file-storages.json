{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/typo3-file-storages.json",
  "title": "TYPO3 file storages",
  "description": "File storages in config/system/file-storages.yaml.",
  "type": ["object", "null"],
  "additionalProperties": false,
  "properties": {
    "imports": {
      "$ref": "https://www.schemastore.org/partial-typo3-imports.json"
    },
    "storages": {
      "description": "File storages, keyed by numeric ID.",
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]*$": {
          "$ref": "#/definitions/storage"
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "placeholder": {
      "description": "Placeholder like %env(MY_VARIABLE)%.",
      "type": "string",
      "pattern": "%.*%"
    },
    "booleanLike": {
      "description": "Boolean, 0/1, text like \"off\" or a placeholder.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "enum": [
            0,
            1,
            "0",
            "1",
            "true",
            "false",
            "on",
            "off",
            "yes",
            "no",
            ""
          ]
        },
        {
          "$ref": "#/definitions/placeholder"
        }
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Name in the backend.",
          "type": "string"
        },
        "driver": {
          "description": "Driver of the storage.",
          "anyOf": [
            {
              "enum": ["Local"]
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "default": "Local"
        },
        "default": {
          "description": "Marks the default storage.",
          "allOf": [
            {
              "$ref": "#/definitions/booleanLike"
            }
          ],
          "default": false
        },
        "browsable": {
          "description": "Shows the storage in the file browser.",
          "allOf": [
            {
              "$ref": "#/definitions/booleanLike"
            }
          ],
          "default": true
        },
        "public": {
          "description": "Files are publicly accessible through a URL.",
          "allOf": [
            {
              "$ref": "#/definitions/booleanLike"
            }
          ],
          "default": true
        },
        "writable": {
          "description": "Allows changing files.",
          "allOf": [
            {
              "$ref": "#/definitions/booleanLike"
            }
          ],
          "default": true
        },
        "online": {
          "description": "Makes the storage available.",
          "allOf": [
            {
              "$ref": "#/definitions/booleanLike"
            }
          ],
          "default": true
        },
        "autoExtractMetadata": {
          "description": "Extracts file metadata automatically.",
          "allOf": [
            {
              "$ref": "#/definitions/booleanLike"
            }
          ],
          "default": true
        },
        "processingFolder": {
          "description": "Folder for processed files like resized images.",
          "type": "string"
        },
        "allowedFileExtensions": {
          "description": "Allowed file extensions.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "configuration": {
          "description": "Options of the driver.",
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": ["driver"]
                }
              },
              {
                "properties": {
                  "driver": {
                    "const": "Local"
                  }
                },
                "required": ["driver"]
              }
            ]
          },
          "then": {
            "properties": {
              "configuration": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "basePath": {
                    "description": "Directory of the storage, for example \"public/fileadmin/\".",
                    "type": "string"
                  },
                  "baseUri": {
                    "description": "URL the files are delivered from.",
                    "type": "string"
                  },
                  "caseSensitive": {
                    "description": "File names are case sensitive.",
                    "allOf": [
                      {
                        "$ref": "#/definitions/booleanLike"
                      }
                    ]
                  },
                  "pathType": {
                    "description": "Deprecated.",
                    "enum": ["relative", "absolute"]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
