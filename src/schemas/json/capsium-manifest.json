{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.capsium.org/schemas/manifest.schema.json",
  "type": "object",
  "properties": {
    "resources": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "type": "string",
            "enum": ["exported", "private"]
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["type"]
      }
    }
  },
  "required": ["resources"]
}
