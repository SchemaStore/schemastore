{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/typo3-form-definition.json",
  "title": "TYPO3 form definition",
  "description": "Form in Resources/Private/Forms/<name>.form.yaml.",
  "type": "object",
  "required": ["identifier", "type"],
  "additionalProperties": false,
  "properties": {
    "imports": {
      "description": "Other YAML files to include.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource"],
        "additionalProperties": false,
        "properties": {
          "resource": {
            "description": "Absolute, relative or \"EXT:\" path of the file.",
            "type": "string",
            "examples": ["EXT:my_extension/Configuration/Routes/Default.yaml"]
          },
          "glob": {
            "description": "Treats resource as a pattern like \"*.yaml\".",
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "identifier": {
      "description": "Unique identifier of the form.",
      "type": "string"
    },
    "type": {
      "description": "Always \"Form\".",
      "const": "Form"
    },
    "label": {
      "description": "Title of the form.",
      "type": "string"
    },
    "prototypeName": {
      "description": "Prototype the form is based on.",
      "type": "string",
      "default": "standard"
    },
    "rendererClassName": {
      "description": "Class rendering the form.",
      "type": "string"
    },
    "renderingOptions": {
      "description": "Rendering options, for example submitButtonLabel.",
      "type": "object"
    },
    "finishers": {
      "description": "Actions run after submitting.",
      "type": ["array", "object"],
      "items": {
        "$ref": "#/definitions/finisher"
      },
      "maxProperties": 0
    },
    "renderables": {
      "description": "Pages of the form.",
      "type": ["array", "object"],
      "items": {
        "$ref": "#/definitions/renderable"
      },
      "maxProperties": 0
    },
    "variants": {
      "description": "Variants of the form.",
      "type": ["array", "object"],
      "items": {
        "$ref": "#/definitions/variant"
      },
      "maxProperties": 0
    },
    "formEditor": {
      "description": "Options for the form editor.",
      "type": "object"
    }
  },
  "definitions": {
    "renderable": {
      "type": "object",
      "required": ["identifier", "type"],
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "description": "Unique identifier of the element.",
          "type": "string"
        },
        "type": {
          "description": "Type of the element.",
          "anyOf": [
            {
              "enum": [
                "AdvancedPassword",
                "Checkbox",
                "ContentElement",
                "CountrySelect",
                "Date",
                "Email",
                "Fieldset",
                "FileUpload",
                "GridColumn",
                "GridRow",
                "Hidden",
                "Honeypot",
                "ImageUpload",
                "MultiCheckbox",
                "MultiSelect",
                "Number",
                "Page",
                "Password",
                "RadioButton",
                "SingleSelect",
                "StaticText",
                "SummaryPage",
                "Telephone",
                "Text",
                "Textarea",
                "Url"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "label": {
          "description": "Label of the element.",
          "type": "string"
        },
        "defaultValue": {
          "description": "Initial value of the element."
        },
        "properties": {
          "description": "Properties of the element, for example options of a select.",
          "type": "object"
        },
        "renderingOptions": {
          "description": "Rendering options.",
          "type": "object"
        },
        "validators": {
          "description": "Validators applied to the submitted value.",
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/validator"
          },
          "maxProperties": 0
        },
        "renderables": {
          "description": "Elements of this page or section.",
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/renderable"
          },
          "maxProperties": 0
        },
        "variants": {
          "description": "Variants of the element.",
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/variant"
          },
          "maxProperties": 0
        },
        "formEditor": {
          "description": "Options for the form editor.",
          "type": "object"
        }
      }
    },
    "finisher": {
      "type": "object",
      "required": ["identifier"],
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "description": "Finisher, as defined in the prototype.",
          "anyOf": [
            {
              "enum": [
                "Closure",
                "Confirmation",
                "DeleteUploads",
                "EmailToReceiver",
                "EmailToSender",
                "FlashMessage",
                "Redirect",
                "SaveToDatabase"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "options": {
          "description": "Options of the finisher.",
          "type": "object"
        }
      }
    },
    "validator": {
      "type": "object",
      "required": ["identifier"],
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "description": "Validator, as defined in the prototype.",
          "anyOf": [
            {
              "enum": [
                "Alphanumeric",
                "Count",
                "DateRange",
                "DateTime",
                "EmailAddress",
                "FileSize",
                "Float",
                "Integer",
                "NotEmpty",
                "Number",
                "NumberRange",
                "RegularExpression",
                "StringLength",
                "Text"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "options": {
          "description": "Options of the validator.",
          "type": "object"
        }
      }
    },
    "variant": {
      "type": "object",
      "required": ["identifier"],
      "properties": {
        "identifier": {
          "description": "Identifier of the variant.",
          "type": "string"
        },
        "condition": {
          "description": "Expression, for example 'stepType == \"SummaryPage\"'.",
          "type": "string"
        }
      }
    }
  }
}
