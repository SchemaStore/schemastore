{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/haijun-turborepo.json",
  "$comment": "Haijun Turborepo Config - Adapted from turbo.build/schema.json for Haijun Ecosystem",
  "title": "HaijunTurborepoConfig",
  "description": "Configuration schema for turbo.json in Haijun projects. An object representing the task dependency graph of your project. turbo interprets these conventions to schedule, execute, and cache the outputs of tasks in your project.\n\nDocumentation: https://turborepo.dev/docs/reference/configuration\nHaijun Ecosystem: https://tracks.web.id",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema URL for validation.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "cacheDir": {
      "description": "Specify the filesystem cache directory.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "cacheMaxAge": {
      "description": "Maximum age of local cache entries before automatic eviction.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "cacheMaxSize": {
      "description": "Maximum total size of the local filesystem cache.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "concurrency": {
      "description": "Set/limit the maximum concurrency for task execution.",
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "dangerouslyDisablePackageManagerCheck": {
      "description": "Disable package manager declaration checks in root package.json.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "envMode": {
      "description": "Turborepo's Environment Modes allow you to control which environment variables are available to a task at runtime.",
      "anyOf": [
        { "type": "string", "enum": ["loose", "strict"] },
        { "type": "null" }
      ]
    },
    "globalDependencies": {
      "description": "A list of globs to include in the set of implicit global hash dependencies.",
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "globalEnv": {
      "description": "A list of environment variables for implicit global hash dependencies.",
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "globalPassThroughEnv": {
      "description": "An allowlist of environment variables that should be made to all tasks, but should not contribute to the task's cache key.",
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "noUpdateNotifier": {
      "description": "When set to true, disables the update notification that appears when a new version of turbo is available.",
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "remoteCache": {
      "description": "Configuration options when interfacing with the remote cache.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "apiUrl": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "enabled": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
            "loginUrl": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "preflight": {
              "anyOf": [{ "type": "boolean" }, { "type": "null" }]
            },
            "signature": {
              "anyOf": [{ "type": "boolean" }, { "type": "null" }]
            },
            "teamId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "teamSlug": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "timeout": {
              "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
            },
            "uploadTimeout": {
              "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "tasks": {
      "description": "An object representing the task dependency graph of your project.",
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cache": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
          "dependsOn": {
            "anyOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "null" }
            ]
          },
          "description": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "env": { "type": ["array", "null"], "items": { "type": "string" } },
          "inputs": {
            "type": ["array", "null"],
            "items": { "anyOf": [{ "type": "string" }, { "type": "object" }] }
          },
          "interactive": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "interruptible": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "outputLogs": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["full", "none", "hash-only", "new-only", "errors-only"]
              },
              { "type": "null" }
            ]
          },
          "outputs": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "passThroughEnv": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "persistent": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "with": { "type": ["array", "null"], "items": { "type": "string" } }
        }
      }
    },
    "ui": {
      "description": "Enable use of the UI for turbo.",
      "anyOf": [
        { "type": "string", "enum": ["tui", "stream"] },
        { "type": "null" }
      ]
    }
  }
}
