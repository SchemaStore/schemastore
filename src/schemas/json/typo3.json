{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/typo3.json",
  "title": "TYPO3 site configuration",
  "type": "object",
  "properties": {
    "imports": {
      "$ref": "https://www.schemastore.org/partial-typo3-imports.json"
    },
    "rootPageId": {
      "description": "ID of the root page.",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$"
        },
        {
          "$ref": "#/definitions/placeholder"
        }
      ]
    },
    "base": {
      "description": "Entry point, for example \"https://example.com/\" or \"/\".",
      "type": "string"
    },
    "baseVariants": {
      "description": "Other entry points, for example per environment.",
      "type": ["array", "object"],
      "items": {
        "$ref": "#/definitions/baseVariant"
      },
      "additionalProperties": {
        "$ref": "#/definitions/baseVariant"
      }
    },
    "websiteTitle": {
      "description": "Title of the website.",
      "type": "string"
    },
    "dependencies": {
      "description": "Site sets used by the site.",
      "type": ["array", "object"],
      "items": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "languages": {
      "description": "Languages of the site.",
      "type": ["array", "object"],
      "items": {
        "$ref": "#/definitions/language"
      },
      "additionalProperties": {
        "$ref": "#/definitions/language"
      }
    },
    "errorHandling": {
      "description": "Error handlers by HTTP status code.",
      "type": ["array", "object"],
      "items": {
        "$ref": "#/definitions/errorHandler"
      },
      "additionalProperties": {
        "$ref": "#/definitions/errorHandler"
      }
    },
    "routes": {
      "description": "Static routes like robots.txt.",
      "type": ["array", "object"],
      "items": {
        "$ref": "#/definitions/staticRoute"
      },
      "maxProperties": 0
    },
    "routeEnhancers": {
      "$ref": "https://www.schemastore.org/partial-typo3-route-enhancers.json"
    },
    "settings": {
      "description": "Site settings, usually in settings.yaml.",
      "type": "object"
    }
  },
  "if": {
    "not": {
      "required": ["imports"]
    }
  },
  "then": {
    "required": ["rootPageId"]
  },
  "definitions": {
    "placeholder": {
      "description": "Placeholder like %env(MY_VARIABLE)%.",
      "type": "string",
      "pattern": "%.*%"
    },
    "baseVariant": {
      "type": "object",
      "required": ["base", "condition"],
      "properties": {
        "base": {
          "description": "Entry point used if the condition matches.",
          "type": "string"
        },
        "condition": {
          "description": "Expression, for example 'applicationContext == \"Development\"'.",
          "type": "string"
        }
      }
    },
    "language": {
      "type": "object",
      "required": ["languageId", "locale"],
      "properties": {
        "languageId": {
          "description": "ID of the language, 0 for the default language.",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            {
              "$ref": "#/definitions/placeholder"
            }
          ]
        },
        "title": {
          "description": "Name of the language in the backend.",
          "type": "string"
        },
        "navigationTitle": {
          "description": "Name of the language in the frontend.",
          "type": "string"
        },
        "websiteTitle": {
          "description": "Title of the website in this language.",
          "type": "string"
        },
        "base": {
          "description": "Entry point of the language, for example \"/de/\".",
          "type": "string"
        },
        "baseVariants": {
          "description": "Other entry points of the language.",
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/baseVariant"
          },
          "additionalProperties": {
            "$ref": "#/definitions/baseVariant"
          }
        },
        "locale": {
          "description": "Locale, for example \"de_DE.UTF-8\" or \"de-DE\".",
          "type": "string",
          "examples": ["en_US.UTF-8", "de_DE.UTF-8"]
        },
        "hreflang": {
          "description": "Value of the hreflang attribute.",
          "type": "string"
        },
        "enabled": {
          "description": "Makes the language available in the frontend.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [0, 1]
            },
            {
              "$ref": "#/definitions/placeholder"
            }
          ],
          "default": true
        },
        "flag": {
          "description": "Flag icon in the backend, for example \"de\" or \"global\".",
          "type": "string"
        },
        "fallbackType": {
          "description": "Behaviour for missing translations.",
          "anyOf": [
            {
              "enum": ["strict", "fallback", "free"]
            },
            {
              "$ref": "#/definitions/placeholder"
            }
          ]
        },
        "fallbacks": {
          "description": "IDs of fallback languages.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "array",
              "items": {
                "type": ["integer", "string"]
              }
            }
          ]
        },
        "typo3Language": {
          "description": "Deprecated since TYPO3 v12.3.",
          "type": "string"
        }
      }
    },
    "errorHandler": {
      "type": "object",
      "required": ["errorCode", "errorHandler"],
      "properties": {
        "errorCode": {
          "description": "HTTP status code, 0 for all others.",
          "anyOf": [
            {
              "type": "integer",
              "examples": [404, 403, 500, 503, 0]
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        },
        "errorHandler": {
          "description": "How the error is handled.",
          "enum": ["Page", "Fluid", "PHP", "LoginRedirect"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "errorHandler": {
                "const": "Page"
              }
            },
            "required": ["errorHandler"]
          },
          "then": {
            "properties": {
              "errorContentSource": {
                "description": "Page or URL to show, for example \"t3://page?uid=123\".",
                "type": "string"
              }
            },
            "required": ["errorContentSource"]
          }
        },
        {
          "if": {
            "properties": {
              "errorHandler": {
                "const": "Fluid"
              }
            },
            "required": ["errorHandler"]
          },
          "then": {
            "properties": {
              "errorFluidTemplate": {
                "description": "Fluid template, for example \"EXT:my_extension/Resources/Private/Templates/Error.fluid.html\".",
                "type": "string"
              },
              "errorFluidTemplatesRootPath": {
                "description": "Templates root path.",
                "type": "string"
              },
              "errorFluidLayoutsRootPath": {
                "description": "Layouts root path.",
                "type": "string"
              },
              "errorFluidPartialsRootPath": {
                "description": "Partials root path.",
                "type": "string"
              }
            },
            "required": ["errorFluidTemplate"]
          }
        },
        {
          "if": {
            "properties": {
              "errorHandler": {
                "const": "PHP"
              }
            },
            "required": ["errorHandler"]
          },
          "then": {
            "properties": {
              "errorPhpClassFQCN": {
                "description": "Class implementing PageErrorHandlerInterface.",
                "type": "string"
              }
            },
            "required": ["errorPhpClassFQCN"]
          }
        },
        {
          "if": {
            "properties": {
              "errorHandler": {
                "const": "LoginRedirect"
              }
            },
            "required": ["errorHandler"]
          },
          "then": {
            "properties": {
              "loginRedirectTarget": {
                "description": "Page with the login form, for example \"t3://page?uid=123\".",
                "type": "string"
              },
              "loginRedirectParameter": {
                "description": "Query parameter for the return URL.",
                "anyOf": [
                  {
                    "enum": ["return_url", "redirect_url"]
                  },
                  {
                    "type": "string"
                  }
                ],
                "default": "return_url"
              }
            },
            "required": ["loginRedirectTarget"]
          }
        }
      ]
    },
    "staticRoute": {
      "type": "object",
      "required": ["route", "type"],
      "properties": {
        "route": {
          "description": "Path of the route, for example \"robots.txt\".",
          "type": "string"
        },
        "type": {
          "description": "Type of the route.",
          "enum": ["staticText", "uri", "asset"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "staticText"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "content": {
                "description": "Text to deliver.",
                "type": "string"
              }
            },
            "required": ["content"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "uri"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "source": {
                "description": "Page, URL or file to deliver, for example \"t3://file?uid=1\".",
                "type": "string"
              }
            },
            "required": ["source"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "asset"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "asset": {
                "description": "Asset to deliver, for example \"EXT:my_extension/Resources/Public/robots.txt\".",
                "type": "string"
              }
            },
            "required": ["asset"]
          }
        }
      ]
    }
  }
}
