{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/hias-hitf.json",
  "title": "hitf-cli-md Configuration",
  "description": "Configuration file for hitf-cli translation toolkit",
  "type": "object",
  "properties": {
    "translationSetting": {
      "type": "object",
      "description": "Translation service and locale configuration",
      "properties": {
        "locales": {
          "type": "array",
          "description": "Language codes. First element is source language, rest are target languages",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "default": ["zh-CN", "en-US"],
          "examples": [
            ["zh-CN", "en-US"],
            ["zh-CN", "en-US", "ja-JP"]
          ]
        },
        "outDir": {
          "oneOf": [
            {
              "type": "string",
              "description": "Output directory for locale files"
            },
            {
              "type": "object",
              "description": "Map project name to output directory",
              "additionalProperties": {
                "type": "string"
              }
            }
          ],
          "default": ".hitf/lang"
        },
        "fallbackToKey": {
          "type": "boolean",
          "description": "Use translation key as fallback when translation is unavailable",
          "default": true
        },
        "replaceOriginalFile": {
          "type": "boolean",
          "description": "Replace Chinese text in source files with $t() calls",
          "default": false
        },
        "i18nCallTemplate": {
          "oneOf": [
            {
              "type": "string",
              "description": "i18n function call template"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "default": "$t",
          "examples": ["$t", ["$t", "i18n.t"]]
        },
        "i18nImport": {
          "oneOf": [
            {
              "type": "string",
              "description": "Import statement for i18n function"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "default": "",
          "examples": [
            "import i18n from '@/i18n'",
            "import { useI18n } from 'vue-i18n'"
          ]
        },
        "extensions": {
          "type": "array",
          "description": "Custom file extensions to process (empty = use defaults)",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "capitalizeTranslations": {
          "type": "boolean",
          "description": "Capitalize first letter of translations for target languages",
          "default": false
        },
        "capitalizeMaxWords": {
          "type": "number",
          "description": "Maximum words to capitalize (0 = all)",
          "minimum": 0,
          "default": 0
        },
        "pruneUnusedKeys": {
          "type": "boolean",
          "description": "Remove unused keys from locale files",
          "default": false
        },
        "keyStrategy": {
          "type": "object",
          "description": "Key generation strategy",
          "properties": {
            "maxLength": {
              "type": "number",
              "description": "Maximum key length",
              "default": 40
            },
            "collision": {
              "type": "string",
              "enum": ["number", "hash"],
              "description": "Strategy for handling key collisions",
              "default": "number"
            },
            "hashLength": {
              "type": "number",
              "description": "Length of hash suffix when collision strategy is 'hash'",
              "default": 6
            }
          }
        },
        "translationService": {
          "type": "string",
          "enum": ["baidu", "tencent", "openai", "google"],
          "description": "Primary translation service",
          "default": "tencent"
        },
        "servicePriority": {
          "type": "array",
          "description": "Fallback order when primary service fails",
          "items": {
            "type": "string",
            "enum": ["baidu", "tencent", "openai", "google"]
          },
          "default": ["tencent", "baidu", "openai", "google"]
        },
        "services": {
          "type": "object",
          "description": "Translation service credentials and options",
          "properties": {
            "openai": {
              "type": "object",
              "properties": {
                "apiKey": {
                  "type": "string",
                  "description": "OpenAI API key",
                  "default": ""
                },
                "baseUrl": {
                  "type": "string",
                  "description": "API base URL (for custom endpoints)",
                  "default": "https://api.openai.com"
                },
                "model": {
                  "type": "string",
                  "description": "Model name",
                  "default": "gpt-3.5-turbo"
                }
              }
            },
            "google": {
              "type": "object",
              "properties": {
                "apiKey": {
                  "type": "string",
                  "description": "Google Cloud Translation API key",
                  "default": ""
                }
              }
            },
            "baidu": {
              "type": "object",
              "properties": {
                "appId": {
                  "type": "string",
                  "description": "Baidu Translate App ID",
                  "default": ""
                },
                "secretKey": {
                  "type": "string",
                  "description": "Baidu Translate Secret Key",
                  "default": ""
                }
              }
            },
            "tencent": {
              "type": "object",
              "properties": {
                "secretId": {
                  "type": "string",
                  "description": "Tencent Cloud SecretId",
                  "default": ""
                },
                "secretKey": {
                  "type": "string",
                  "description": "Tencent Cloud SecretKey",
                  "default": ""
                },
                "region": {
                  "type": "string",
                  "description": "Tencent Cloud region",
                  "default": "ap-guangzhou"
                }
              }
            }
          }
        }
      }
    },
    "gitRepoSetting": {
      "type": "object",
      "description": "Git repository sync configuration",
      "properties": {
        "gitRepoAutoUpdate": {
          "type": "boolean",
          "description": "Auto-update git repositories on translation",
          "default": false
        },
        "gitRepoMode": {
          "type": "string",
          "enum": ["merge", "overwrite"],
          "description": "How to handle repository sync conflicts",
          "default": "merge"
        },
        "gitRepo": {
          "type": "object",
          "description": "Map project name to git repository URL",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "language": {
      "type": "string",
      "description": "CLI interface language (global config only)",
      "enum": ["zh-CN", "en-US"],
      "default": "zh-CN"
    }
  }
}
