{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.schemastore.org/k2f-manifest.json",
  "title": "K2F Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": ["integer", "null"],
      "description": "UTC unix seconds. Must be stored in the source file; pack must not stamp wall-clock time."
    },
    "canvas_mode": {
      "const": "paged",
      "description": "Formal documents are paged only."
    },
    "page_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Page width (Pt in 1/1000 pt units)."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Page height (Pt in 1/1000 pt units)."
        },
        "margin": {
          "type": "array",
          "description": "[top, right, bottom, left] (Pt in 1/1000 pt units).",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": ["width", "height", "margin"]
    },
    "engine_version": {
      "type": "string"
    },
    "generated_by": {
      "type": ["string", "null"],
      "description": "Agent or model id that wrote the tree. Not the human signer."
    },
    "running_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "position": {
            "enum": ["header", "footer"]
          },
          "node": {
            "$ref": "https://www.schemastore.org/k2f-nodes.json"
          }
        },
        "required": ["position", "node"]
      }
    }
  },
  "required": ["title", "canvas_mode", "page_config", "engine_version"]
}
