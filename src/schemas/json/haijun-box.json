{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/haijun-box.json",
  "$comment": "Haijun Box Plugin Manifest - Based on OpenAI Plugin Manifest format for CLI desktop AI",
  "type": "object",
  "description": "Haijun Box plugin manifest for extending Haijun Box CLI capabilities. Haijun Box is a CLI desktop AI assistant.",
  "required": [
    "schema_version",
    "name_for_human",
    "name_for_model",
    "description_for_human",
    "description_for_model",
    "auth",
    "api"
  ],
  "properties": {
    "$schema": {
      "description": "JSON Schema reference for editor autocomplete/validation",
      "type": "string"
    },
    "schema_version": {
      "description": "Manifest schema version",
      "type": "string",
      "enum": ["v1"],
      "default": "v1"
    },
    "name_for_human": {
      "description": "Human-readable name of the plugin (shown in plugin list)",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "name_for_model": {
      "description": "Unique identifier used by the AI model to reference this plugin",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "description_for_human": {
      "description": "Human-readable description of what the plugin does",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description_for_model": {
      "description": "Description used by the AI model to understand when and how to use this plugin",
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "auth": {
      "description": "Authentication configuration for the plugin API",
      "type": "object",
      "properties": {
        "type": {
          "description": "Authentication type",
          "type": "string",
          "enum": ["none", "service_http", "user_http", "oauth"],
          "default": "none"
        },
        "authorization_type": {
          "description": "OAuth authorization type (when type is oauth)",
          "type": "string",
          "enum": ["bearer", "basic"]
        },
        "authorization_url": {
          "description": "OAuth authorization URL",
          "type": "string",
          "format": "uri"
        },
        "client_url": {
          "description": "OAuth client URL",
          "type": "string",
          "format": "uri"
        },
        "scope": {
          "description": "OAuth scopes",
          "type": "string"
        },
        "verification_tokens": {
          "description": "Verification tokens for webhook authentication",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "instructions": {
          "description": "Additional authentication instructions",
          "type": "string"
        }
      },
      "required": ["type"]
    },
    "api": {
      "description": "API configuration for the plugin",
      "type": "object",
      "properties": {
        "type": {
          "description": "API specification type",
          "type": "string",
          "enum": ["openapi"],
          "default": "openapi"
        },
        "url": {
          "description": "URL to the OpenAPI specification (JSON or YAML)",
          "type": "string",
          "format": "uri"
        },
        "has_user_authentication": {
          "description": "Whether the API requires user authentication",
          "type": "boolean",
          "default": false
        }
      },
      "required": ["type", "url"]
    },
    "logo_url": {
      "description": "URL to the plugin logo image (recommended: 512x512 PNG)",
      "type": "string",
      "format": "uri"
    },
    "contact_email": {
      "description": "Contact email for support or feedback",
      "type": "string",
      "format": "email"
    },
    "legal_info_url": {
      "description": "URL to legal information (terms of service, privacy policy)",
      "type": "string",
      "format": "uri"
    },
    "max_instances": {
      "description": "Maximum number of instances of this plugin that can be active simultaneously",
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "enabled_by_default": {
      "description": "Whether the plugin is enabled by default when installed",
      "type": "boolean",
      "default": true
    },
    "categories": {
      "description": "Categories for plugin discovery and organization",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "productivity",
          "development",
          "communication",
          "data",
          "utilities",
          "entertainment",
          "education",
          "finance",
          "health",
          "other"
        ]
      },
      "uniqueItems": true
    },
    "keywords": {
      "description": "Keywords for plugin discovery",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "maxItems": 10
    },
    "tools": {
      "description": "Tools provided by this plugin that the AI can use",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Unique tool name (used in function calls)",
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "description": {
            "description": "Tool description for the AI model",
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "description": "Tool parameters in JSON Schema format",
            "type": "object"
          }
        },
        "required": ["name", "description"]
      }
    },
    "dependencies": {
      "description": "Other plugins required by this plugin",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "permissions": {
      "description": "System permissions requested by this plugin",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "file_read",
          "file_write",
          "network",
          "shell",
          "clipboard",
          "notification"
        ]
      }
    }
  },
  "additionalProperties": false
}
