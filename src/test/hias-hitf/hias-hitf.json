{
  "gitRepoSetting": {
    "gitRepo": {},
    "gitRepoAutoUpdate": false,
    "gitRepoMode": "merge"
  },
  "language": "zh-CN",
  "translationSetting": {
    "capitalizeMaxWords": 0,
    "capitalizeTranslations": false,
    "extensions": [],
    "fallbackToKey": true,
    "i18nCallTemplate": "$t",
    "i18nImport": "import i18n from '@/i18n'",
    "keyStrategy": {
      "collision": "number",
      "hashLength": 6,
      "maxLength": 40
    },
    "locales": ["zh-CN", "en-US", "ja-JP"],
    "outDir": ".hitf/lang",
    "pruneUnusedKeys": false,
    "replaceOriginalFile": false,
    "servicePriority": ["tencent", "baidu", "openai", "google"],
    "services": {
      "tencent": {
        "region": "ap-guangzhou",
        "secretId": "",
        "secretKey": ""
      }
    },
    "translationService": "tencent"
  }
}
