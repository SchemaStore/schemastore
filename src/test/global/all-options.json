{
  "msbuild-sdks": {
    "Cake.Sdk": "6.0.0",
    "Microsoft.Build.Traversal": "4.1.0"
  },
  "sdk": {
    "allowPrerelease": false,
    "errorMessage": "The required .NET SDK wasn't found. Please run ./install.sh to install it.",
    "paths": [".dotnet", "$host$"],
    "rollForward": "latestFeature",
    "version": "10.0.100"
  },
  "test": {
    "runner": "Microsoft.Testing.Platform"
  }
}
