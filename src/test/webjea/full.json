{
  "$schema": "https://www.schemastore.org/webjea.json",
  "Title": "Helpdesk Portal",
  "BasePath": "C:\\webjea\\scripts",
  "LogParameters": false,
  "PermittedGroups": ["CONTOSO\\WebJEA Admins"],
  "SendTelemetry": false,
  "DashboardHtml": "<b>Pick a command from the menu.</b>",
  "HtmlLanguage": "de-DE",
  "ShowVerbose": false,
  "DefaultCommandId": "unlock",
  "RenderMode": "Markdown",
  "Commands": [
    {
      "Id": "unlock",
      "DisplayName": "Unlock User",
      "Synopsis": "Unlocks a locked <i>Active Directory</i> account.",
      "OnloadScript": "unlock-onload.ps1",
      "Script": "unlock.ps1",
      "LogParameters": true,
      "PermittedGroups": ["CONTOSO\\Helpdesk", "CONTOSO\\Tier2"],
      "RenderMode": "Legacy"
    },
    {
      "Id": "reset-password",
      "DisplayName": "Reset Password",
      "Script": "reset-password.ps1",
      "LogParameters": false,
      "PermittedGroups": "CONTOSO\\Helpdesk",
      "RenderMode": "Markdown"
    },
    {
      "Id": "runbook",
      "DisplayName": "Runbook",
      "OnloadScript": "runbook.ps1",
      "PermittedGroups": "*",
      "RenderMode": "Link"
    },
    {
      "Id": "status",
      "DisplayName": null,
      "Synopsis": null,
      "OnloadScript": "status.ps1",
      "Script": null,
      "LogParameters": null,
      "PermittedGroups": ["*"]
    }
  ]
}
