{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/bin/bash ~/.claude/hooks/check-command.sh",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          },
          {
            "onFailure": "continue",
            "type": "http",
            "url": "http://localhost:8080/hooks/pre-tool-use"
          },
          {
            "onFailure": "block",
            "server": "policy",
            "tool": "check_tool_call",
            "type": "mcp_tool"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
