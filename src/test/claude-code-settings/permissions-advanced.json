{
  "permissions": {
    "additionalDirectories": ["~/Documents/shared-projects", "//tmp"],
    "allow": [
      "Agent(Explore)",
      "Glob",
      "Grep",
      "Read(*)",
      "Read(~/projects/**)",
      "Skill(*)",
      "Edit(~/projects/**)",
      "MultiEdit",
      "MultiEdit(~/projects/**)",
      "ToolSearch",
      "LSP",
      "NotebookEdit",
      "TodoWrite",
      "WebFetch(domain:github.com)",
      "WebSearch",
      "mcp__ide__getDiagnostics",
      "mcp__ide__executeCode",
      "Artifact",
      "EnterWorktree(*)",
      "Workflow"
    ],
    "ask": ["Write(~/projects/**)", "Bash(make:*)", "ShareOnboardingGuide"],
    "defaultMode": "acceptEdits",
    "deny": ["Bash(rm:*)", "Write(/etc/**)", "WebFetch(domain:malicious.com)"],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "credentials": {
      "envVars": [
        {
          "mode": "deny",
          "name": "NPM_TOKEN"
        },
        {
          "extract": "^(.+)$",
          "mode": "mask",
          "name": "PYPI_TOKEN",
          "onExtractNoMatch": "deny"
        },
        {
          "extract": "^(.+)$",
          "mode": "mask",
          "name": "GL_TOKEN",
          "onExtractNoMatch": "error"
        }
      ],
      "files": [
        {
          "mode": "deny",
          "path": "~/.aws/credentials"
        },
        {
          "extract": "_authToken=(\\S+)",
          "mode": "mask",
          "onExtractNoMatch": "warn",
          "path": "~/.npmrc"
        },
        {
          "extract": "password:\\s*(\\S+)",
          "mode": "mask",
          "onExtractNoMatch": "error",
          "path": "~/.pypirc"
        }
      ],
      "sigv4": {
        "presigned": "deny",
        "sigv4a": "deny",
        "streaming": "deny"
      }
    }
  }
}
