{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowClaudeInChromeWithManagedMcp": true,
  "allowedChannelPlugins": [
    "telegram@claude-plugins-official",
    { "marketplace": "claude-plugins-official", "plugin": "discord" }
  ],
  "allowedProviders": ["anthropic", "bedrock", "mantle"],
  "appendPlugins": ["audit-log@acme-tools"],
  "attribution": false,
  "autoCompactWindow": 400000,
  "autoContinueAtUsageLimit": false,
  "availableModelsMatch": "exact",
  "bashEditDiffEnabled": true,
  "bashOutputMaxChars": 64000,
  "browserExternalPageTools": "Disable",
  "crossSessionInbound": "refuse",
  "deniedMcpServers": [{ "serverName": "claude.ai Slack" }],
  "deniedModels": ["claude-opus-5-5"],
  "desktopSessionCleanupPeriodDays": 14,
  "dialogExpiry": "10m",
  "disableCommandPluginSources": true,
  "disableDesktopLocalSessions": true,
  "enableWorkflows": true,
  "env": {
    "ANTHROPIC_DEFAULT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0",
    "DISABLE_AUTOUPDATER": "yes",
    "DISABLE_TELEMETRY": "anything",
    "MCP_TIMEOUT": "30000"
  },
  "feedbackDrafts": "quiet",
  "gatewayInternalNetworks": ["11.0.0.0/8", "203.0.113.0/24"],
  "hooks": {
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "command": "~/.local/bin/notify-model-switch",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ".*opus.*"
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "command": "./scripts/check-budget.sh",
            "onFailure": "block",
            "type": "command"
          },
          {
            "onFailure": "continue",
            "type": "http",
            "url": "https://hooks.example.com/model-switch"
          }
        ],
        "matcher": "claude-opus-5"
      }
    ]
  },
  "idleCompaction": false,
  "isolatePeerMachines": true,
  "keybindingFlavor": "readline",
  "managedMcpServers": {
    "search": {
      "headers": { "X-Team": "platform" },
      "type": "http",
      "url": "https://mcp.example.com/search"
    }
  },
  "managedSourcesBehavior": "merge",
  "maxEffortLevel": "xhigh",
  "maxProseWidth": 100,
  "modelPicker": {
    "options": [
      { "label": "Opus (production)", "model": "us.anthropic.claude-opus-4-8" },
      {
        "behavesAs": "claude-sonnet-4-6",
        "description": "Day-to-day work",
        "label": "Sonnet (production)",
        "model": "us.anthropic.claude-sonnet-4-6"
      }
    ],
    "replaceBuiltInOptions": true
  },
  "modelPricing": {
    "multiplier": 0.85,
    "overrides": {
      "claude-sonnet-4-6": {
        "cacheRead": 0.24,
        "cacheWrite": 3,
        "input": 2.4,
        "output": 12
      }
    }
  },
  "modelSettings": {
    "claude-fable-5-1": { "effortLevel": "medium" },
    "claude-opus-5-5": {
      "autoCompactWindow": "auto",
      "effortLevel": "high",
      "maxEffortLevel": "xhigh"
    }
  },
  "permissions": {
    "allow": [
      "Bash(echo $(date))",
      "SendMessage",
      "ScheduleWakeup",
      "mcp__github__get_*"
    ],
    "ask": ["B*", "WebFetch(domain:example.com)"],
    "blockReadsOutsideWorkingDirectories": true,
    "defaultMode": "manual",
    "deny": ["*", "mcp__*", "ListAgents", "Read(./secrets/(old)/**)"]
  },
  "prependPlugins": ["sec-default@builtin"],
  "promptCacheTtl": "1h",
  "promptSuggestionEnabled": false,
  "remote": { "defaultEnvironmentId": "env_01abc" },
  "sandbox": {
    "credentials": {
      "awsPairs": [
        {
          "accessKeyIdVar": "CI_AWS_KEY",
          "secretAccessKeyVar": "CI_AWS_SECRET"
        }
      ],
      "envVars": [
        { "mode": "deny", "name": "NPM_TOKEN" },
        {
          "extract": "://[^:]+:([^@]+)@",
          "mode": "mask",
          "name": "DATABASE_URL",
          "onExtractNoMatch": "deny"
        },
        {
          "decode": "jwt",
          "maskClaims": ["api_key"],
          "mode": "mask",
          "name": "SERVICE_JWT"
        }
      ],
      "files": [
        { "mode": "deny", "path": "~/.aws/credentials" },
        {
          "extract": "oauth_token:\\s*(\\S+)",
          "injectHosts": ["api.github.com"],
          "maskDuplicates": true,
          "mode": "mask",
          "path": "~/.config/gh/hosts.yml"
        }
      ],
      "sigv4": { "presigned": "deny", "streaming": "passthrough" }
    }
  },
  "skipAutoPermissionPrompt": true,
  "spellcheck": {
    "checker": "hunspell",
    "color": "#ff5f5f",
    "enabled": true,
    "language": "en_GB"
  },
  "spinnerTipsOverride": {
    "label": "Acme tip",
    "tips": [
      "Run /review before opening a PR",
      {
        "cooldownSessions": 3,
        "id": "gateway-errors",
        "priority": 2,
        "text": "Seeing 5xx errors? Check the gateway status page first"
      }
    ],
    "tipsFile": "~/.config/acme/tips.json"
  },
  "subagentPromptCacheTtl": "5m",
  "switchModelsOnFlag": false,
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "terminalTitleFromRename": false,
  "timeFormat": "%H:%M",
  "timeZone": "Europe/Dublin",
  "ultracode": true,
  "worktree": { "location": "~/worktrees" }
}
