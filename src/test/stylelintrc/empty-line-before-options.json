{
  "rules": {
    "custom-property-empty-line-before": [
      "always",
      {
        "except": [
          "after-block",
          "after-comment",
          "after-custom-property",
          "first-nested"
        ],
        "ignore": [
          "after-comment",
          "after-custom-property",
          "first-nested",
          "inside-single-line-block"
        ]
      }
    ],
    "declaration-empty-line-before": [
      "always",
      {
        "except": [
          "after-block",
          "after-comment",
          "after-declaration",
          "first-nested"
        ],
        "ignore": [
          "after-comment",
          "after-declaration",
          "first-nested",
          "inside-single-line-block"
        ]
      }
    ]
  }
}
