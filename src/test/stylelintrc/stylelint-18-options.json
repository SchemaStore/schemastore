{
  "allowEmptyInput": true,
  "cache": true,
  "configurationComment": "stylelint-foo-instance",
  "fix": true,
  "formatter": "verbose",
  "languageOptions": {
    "directionality": {
      "block": "top-to-bottom",
      "inline": "right-to-left"
    },
    "syntax": {
      "atRules": {
        "example": {
          "comment": "Example at-rule",
          "descriptors": {
            "bar": "<color>",
            "foo": "<number>"
          },
          "prelude": "<custom-ident>"
        }
      },
      "cssWideKeywords": ["my-global-value"],
      "properties": { "top": "| <--foo()>" },
      "types": { "--foo()": "--foo( <length-percentage> )" },
      "units": { "length": ["--foo"] }
    }
  },
  "maxWarnings": 0,
  "overrides": [
    {
      "customSyntax": "postcss-scss",
      "files": "**/*.scss",
      "name": "SCSS files",
      "referenceFiles": {
        "customSyntax": "postcss-scss",
        "files": ["scss-tokens/*.scss", "vendor/*.scss"]
      }
    }
  ],
  "quiet": false,
  "referenceFiles": [
    "tokens.css",
    {
      "files": "entrypoint.css",
      "loader": "postcss-import"
    }
  ],
  "reportUnscopedDisables": [true, { "severity": "warning" }]
}
