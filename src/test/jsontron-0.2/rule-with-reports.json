{
  "type": "object",
  "rules": [
    {
      "id": "stock-check",
      "context": ".items[]",
      "asserts": [
        {
          "id": "sku-required",
          "test": ".sku | type == \"string\"",
          "message": "sku missing or not a string"
        }
      ],
      "reports": [
        {
          "id": "backorder",
          "flag": "warning",
          "test": ".stock == 0",
          "message": "item \\(.sku) is out of stock"
        }
      ]
    }
  ]
}
