{
  "rules": [
    {
      "asserts": [
        {
          "id": "sku-required",
          "message": "sku missing or not a string",
          "test": ".sku | type == \"string\""
        }
      ],
      "context": ".items[]",
      "id": "stock-check",
      "reports": [
        {
          "flag": "warning",
          "id": "backorder",
          "message": "item \\(.sku) is out of stock",
          "test": ".stock == 0"
        }
      ]
    }
  ],
  "type": "object"
}
