{
  "font_aliases": {
    "Roboto-Regular": "Roboto-Regular"
  },
  "palette": {
    "ink": "#151515",
    "paper": "#FFFFFF",
    "muted": "#5F6368",
    "accent": "#151515",
    "warning_bg": "#FFEBEE",
    "warning_ink": "#C62828",
    "header_bg": "#151515",
    "header_ink": "#FFFFFF",
    "alt_row": "#F5F5F7",
    "signature": "#F5F5F7",
    "rule": "#D2D2D7",
    "disabled": "#15151561"
  },
  "primitives": {
    "surfaces": {
      "paper": { "type": "solid", "color": "paper" },
      "rule": { "type": "solid", "color": "rule" },
      "signature": { "type": "solid", "color": "signature" },
      "header_bg": { "type": "solid", "color": "header_bg" },
      "warning_bg": { "type": "solid", "color": "warning_bg" }
    },
    "corners": { "none": 0, "small": 4000, "medium": 12000 },
    "borders": {
      "subtle": { "color": "#1515151A", "width_pt": 500 },
      "subtle_bottom": { "color": "#1515151A", "width_pt": 500, "edges": ["bottom"] },
      "subtle_hbar": { "color": "#1515151A", "width_pt": 500, "edges": ["top", "bottom"] },
      "contrast": { "color": "#1515154D", "width_pt": 1000 }
    },
    "shadows": {
      "elevation.1": {
        "layers": [
          {
            "blur_radius_pt": 4000,
            "color": "#0000001A",
            "offset_x_pt": 0,
            "offset_y_pt": 2000,
            "spread_radius_pt": 0
          }
        ]
      }
    }
  },
  "modifiers": {
    "precedence": ["emphasis", "link", "math"],
    "styles": {
      "emphasis": {
        "strong": { "bold": true },
        "emphasis": { "italic": true }
      },
      "link": {
        "default": { "underline": true, "color": "accent" }
      },
      "math": {
        "inline": { "color": "ink" }
      },
      "underline": {
        "default": { "underline": true }
      },
      "strikethrough": {
        "default": { "strikethrough": true }
      },
      "subscript": {
        "default": {}
      },
      "superscript": {
        "default": {}
      },
      "syntax_highlight": {
        "keyword": { "color": "accent", "bold": true }
      }
    }
  },
  "roles": {
    "default": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink"
    },
    "document": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink",
      "box_decoration": { "background": "paper" }
    },
    "body": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink",
      "variants": {
        "on_dark": { "text_overrides": { "color": "header_ink" } },
        "end": { "text_overrides": { "text_align": "end" } }
      }
    },
    "image": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink",
      "self_align": "start",
      "variants": {
        "cover": { "image_fit": "cover", "self_align": "stretch" }
      }
    },
    "h1": {
      "font_family": "Roboto-Regular",
      "font_size": 24000,
      "line_height_mult": 1250,
      "color": "ink",
      "bold": true,
      "variants": {
        "on_dark": { "text_overrides": { "color": "header_ink" } }
      }
    },
    "h2": {
      "font_family": "Roboto-Regular",
      "font_size": 18000,
      "line_height_mult": 1300,
      "color": "ink",
      "bold": true,
      "variants": {
        "on_dark": { "text_overrides": { "color": "header_ink" } },
        "end": { "text_overrides": { "text_align": "end" } }
      }
    },
    "h3": {
      "font_family": "Roboto-Regular",
      "font_size": 14000,
      "line_height_mult": 1350,
      "color": "ink",
      "bold": true
    },
    "h4": {
      "font_family": "Roboto-Regular",
      "font_size": 12000,
      "line_height_mult": 1400,
      "color": "ink",
      "bold": true
    },
    "warning": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "warning_ink",
      "box_decoration": {
        "background": "warning_bg",
        "corner_radius": "small",
        "padding_pt": 12000
      }
    },
    "badge": {
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200,
      "color": "ink",
      "bold": true,
      "self_align": "start",
      "box_decoration": {
        "background": "signature",
        "corner_radius": "small",
        "padding_pt": { "top": 3000, "right": 8000, "bottom": 3000, "left": 8000 }
      }
    },
    "section": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink",
      "variants": {
        "banner": {
          "box_decoration": {
            "background": "header_bg",
            "padding_pt": { "top": 24000, "right": 36000, "bottom": 24000, "left": 36000 }
          }
        }
      }
    },
    "page_shell": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink",
      "box_decoration": {
        "padding_pt": 36000
      },
      "variants": {
        "flush": {
          "box_decoration": {
            "padding_pt": 0
          }
        }
      }
    },
    "table": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "ink",
      "variants": {
        "ruled": { "box_decoration": { "border": "subtle_hbar" } }
      }
    },
    "table_header_cell": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "header_ink",
      "box_decoration": {
        "background": "header_bg",
        "corner_radius": "small",
        "padding_pt": 6000
      },
      "variants": {
        "center": { "self_align": "center" },
        "end": { "text_overrides": { "text_align": "end" } },
        "bottom": { "box_decoration": { "border": "subtle_bottom" } },
        "hbar": { "box_decoration": { "border": "subtle_hbar" } },
        "compact": { "box_decoration": { "padding_pt": 3000 } }
      }
    },
    "table_row_cell": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "ink",
      "box_decoration": { "padding_pt": 6000 },
      "variants": {
        "center": { "self_align": "center" },
        "end": { "text_overrides": { "text_align": "end" } },
        "bottom": { "box_decoration": { "border": "subtle_bottom" } },
        "hbar": { "box_decoration": { "border": "subtle_hbar" } },
        "compact": { "box_decoration": { "padding_pt": 3000 } },
        "on_dark": {
          "text_overrides": { "color": "header_ink" },
          "box_decoration": { "padding_pt": 3000 }
        }
      }
    },
    "list_item": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500,
      "color": "ink",
      "list_style": {
        "bullet_glyph": "-",
        "depth_indent_pt": 18000,
        "marker_box_width_pt": 18000,
        "marker_gap_pt": 4000,
        "number_suffix": "."
      }
    },
    "code": {
      "font_family": "Roboto-Regular",
      "font_size": 10500,
      "line_height_mult": 1400,
      "color": "ink",
      "box_decoration": {
        "background": "signature",
        "corner_radius": "small",
        "padding_pt": 8000
      }
    },
    "quote": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "color": "muted",
      "box_decoration": {
        "padding_pt": { "top": 0, "right": 0, "bottom": 10000, "left": 16000 }
      }
    },
    "math": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "color": "ink",
      "text_align": "center"
    },
    "running_header": {
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200,
      "color": "muted",
      "variants": {
        "end": { "text_overrides": { "text_align": "end" } }
      }
    },
    "running_footer": {
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200,
      "color": "muted",
      "variants": {
        "end": { "text_overrides": { "text_align": "end" } }
      }
    },
    "signature_block": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "muted",
      "box_decoration": {
        "background": "signature",
        "padding_pt": 16000
      }
    },
    "form_field": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "ink",
      "box_decoration": {
        "padding_pt": { "top": 2000, "right": 4000, "bottom": 2000, "left": 4000 },
        "border": "subtle_bottom"
      },
      "variants": {
        "underline": { "box_decoration": { "border": "subtle_bottom" } },
        "box": { "box_decoration": { "border": "subtle", "corner_radius": "small" } },
        "checkbox": { "box_decoration": { "border": "contrast", "corner_radius": "small" } }
      }
    },
    "rule": {
      "font_family": "Roboto-Regular",
      "font_size": 2000,
      "line_height_mult": 1000,
      "color": "muted",
      "box_decoration": { "background": "rule" }
    },
    "card": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "color": "ink",
      "box_decoration": {
        "background": "paper",
        "corner_radius": "medium",
        "padding_pt": 16000
      },
      "variants": {
        "raised": {
          "box_decoration": {
            "background": "paper",
            "corner_radius": "medium",
            "padding_pt": 16000,
            "shadow": "elevation.1"
          }
        },
        "on_dark": {
          "text_overrides": { "color": "header_ink" },
          "box_decoration": {
            "background": "header_bg",
            "corner_radius": "medium",
            "padding_pt": 16000
          }
        }
      }
    }
  }
}
