{
  "font_aliases": {
    "Roboto-Regular": "Roboto-Regular"
  },
  "modifiers": {
    "precedence": ["emphasis", "link", "math"],
    "styles": {
      "emphasis": {
        "emphasis": { "italic": true },
        "strong": { "bold": true }
      },
      "link": {
        "default": { "color": "accent", "underline": true }
      },
      "math": {
        "inline": { "color": "ink" }
      },
      "strikethrough": {
        "default": { "strikethrough": true }
      },
      "subscript": {
        "default": {}
      },
      "superscript": {
        "default": {}
      },
      "syntax_highlight": {
        "keyword": { "bold": true, "color": "accent" }
      },
      "underline": {
        "default": { "underline": true }
      }
    }
  },
  "palette": {
    "accent": "#151515",
    "alt_row": "#F5F5F7",
    "disabled": "#15151561",
    "header_bg": "#151515",
    "header_ink": "#FFFFFF",
    "ink": "#151515",
    "muted": "#5F6368",
    "paper": "#FFFFFF",
    "rule": "#D2D2D7",
    "signature": "#F5F5F7",
    "warning_bg": "#FFEBEE",
    "warning_ink": "#C62828"
  },
  "primitives": {
    "borders": {
      "contrast": { "color": "#1515154D", "width_pt": 1000 },
      "subtle": { "color": "#1515151A", "width_pt": 500 },
      "subtle_bottom": {
        "color": "#1515151A",
        "edges": ["bottom"],
        "width_pt": 500
      },
      "subtle_hbar": {
        "color": "#1515151A",
        "edges": ["top", "bottom"],
        "width_pt": 500
      }
    },
    "corners": { "medium": 12000, "none": 0, "small": 4000 },
    "shadows": {
      "elevation.1": {
        "layers": [
          {
            "blur_radius_pt": 4000,
            "color": "#0000001A",
            "offset_x_pt": 0,
            "offset_y_pt": 2000,
            "spread_radius_pt": 0
          }
        ]
      }
    },
    "surfaces": {
      "header_bg": { "color": "header_bg", "type": "solid" },
      "paper": { "color": "paper", "type": "solid" },
      "rule": { "color": "rule", "type": "solid" },
      "signature": { "color": "signature", "type": "solid" },
      "warning_bg": { "color": "warning_bg", "type": "solid" }
    }
  },
  "roles": {
    "badge": {
      "bold": true,
      "box_decoration": {
        "background": "signature",
        "corner_radius": "small",
        "padding_pt": {
          "bottom": 3000,
          "left": 8000,
          "right": 8000,
          "top": 3000
        }
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200,
      "self_align": "start"
    },
    "body": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "variants": {
        "end": { "text_overrides": { "text_align": "end" } },
        "on_dark": { "text_overrides": { "color": "header_ink" } }
      }
    },
    "card": {
      "box_decoration": {
        "background": "paper",
        "corner_radius": "medium",
        "padding_pt": 16000
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "variants": {
        "on_dark": {
          "box_decoration": {
            "background": "header_bg",
            "corner_radius": "medium",
            "padding_pt": 16000
          },
          "text_overrides": { "color": "header_ink" }
        },
        "raised": {
          "box_decoration": {
            "background": "paper",
            "corner_radius": "medium",
            "padding_pt": 16000,
            "shadow": "elevation.1"
          }
        }
      }
    },
    "code": {
      "box_decoration": {
        "background": "signature",
        "corner_radius": "small",
        "padding_pt": 8000
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 10500,
      "line_height_mult": 1400
    },
    "default": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350
    },
    "document": {
      "box_decoration": { "background": "paper" },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350
    },
    "form_field": {
      "box_decoration": {
        "border": "subtle_bottom",
        "padding_pt": {
          "bottom": 2000,
          "left": 4000,
          "right": 4000,
          "top": 2000
        }
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "variants": {
        "box": {
          "box_decoration": { "border": "subtle", "corner_radius": "small" }
        },
        "checkbox": {
          "box_decoration": { "border": "contrast", "corner_radius": "small" }
        },
        "underline": { "box_decoration": { "border": "subtle_bottom" } }
      }
    },
    "h1": {
      "bold": true,
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 24000,
      "line_height_mult": 1250,
      "variants": {
        "on_dark": { "text_overrides": { "color": "header_ink" } }
      }
    },
    "h2": {
      "bold": true,
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 18000,
      "line_height_mult": 1300,
      "variants": {
        "end": { "text_overrides": { "text_align": "end" } },
        "on_dark": { "text_overrides": { "color": "header_ink" } }
      }
    },
    "h3": {
      "bold": true,
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 14000,
      "line_height_mult": 1350
    },
    "h4": {
      "bold": true,
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 12000,
      "line_height_mult": 1400
    },
    "image": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "self_align": "start",
      "variants": {
        "cover": { "image_fit": "cover", "self_align": "stretch" }
      }
    },
    "list_item": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500,
      "list_style": {
        "bullet_glyph": "-",
        "depth_indent_pt": 18000,
        "marker_box_width_pt": 18000,
        "marker_gap_pt": 4000,
        "number_suffix": "."
      }
    },
    "math": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "text_align": "center"
    },
    "page_shell": {
      "box_decoration": {
        "padding_pt": 36000
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "variants": {
        "flush": {
          "box_decoration": {
            "padding_pt": 0
          }
        }
      }
    },
    "quote": {
      "box_decoration": {
        "padding_pt": { "bottom": 10000, "left": 16000, "right": 0, "top": 0 }
      },
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600
    },
    "rule": {
      "box_decoration": { "background": "rule" },
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 2000,
      "line_height_mult": 1000
    },
    "running_footer": {
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200,
      "variants": {
        "end": { "text_overrides": { "text_align": "end" } }
      }
    },
    "running_header": {
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200,
      "variants": {
        "end": { "text_overrides": { "text_align": "end" } }
      }
    },
    "section": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "variants": {
        "banner": {
          "box_decoration": {
            "background": "header_bg",
            "padding_pt": {
              "bottom": 24000,
              "left": 36000,
              "right": 36000,
              "top": 24000
            }
          }
        }
      }
    },
    "signature_block": {
      "box_decoration": {
        "background": "signature",
        "padding_pt": 16000
      },
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    },
    "table": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "variants": {
        "ruled": { "box_decoration": { "border": "subtle_hbar" } }
      }
    },
    "table_header_cell": {
      "box_decoration": {
        "background": "header_bg",
        "corner_radius": "small",
        "padding_pt": 6000
      },
      "color": "header_ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "variants": {
        "bottom": { "box_decoration": { "border": "subtle_bottom" } },
        "center": { "self_align": "center" },
        "compact": { "box_decoration": { "padding_pt": 3000 } },
        "end": { "text_overrides": { "text_align": "end" } },
        "hbar": { "box_decoration": { "border": "subtle_hbar" } }
      }
    },
    "table_row_cell": {
      "box_decoration": { "padding_pt": 6000 },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "variants": {
        "bottom": { "box_decoration": { "border": "subtle_bottom" } },
        "center": { "self_align": "center" },
        "compact": { "box_decoration": { "padding_pt": 3000 } },
        "end": { "text_overrides": { "text_align": "end" } },
        "hbar": { "box_decoration": { "border": "subtle_hbar" } },
        "on_dark": {
          "box_decoration": { "padding_pt": 3000 },
          "text_overrides": { "color": "header_ink" }
        }
      }
    },
    "warning": {
      "box_decoration": {
        "background": "warning_bg",
        "corner_radius": "small",
        "padding_pt": 12000
      },
      "color": "warning_ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    }
  }
}
