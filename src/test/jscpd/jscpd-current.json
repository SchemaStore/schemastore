{
  "baseline": ".jscpd-baseline.json",
  "baseline-from-ref": "origin/main",
  "baselineFromRef": "origin/main",
  "basta": true,
  "boundaries": [
    {
      "allow": ["web/e2e/**"],
      "code": ["backend/billing/**", "backend/loans/Interest.kt#(*Payments)"],
      "name": "money",
      "notIn": ["web/**", "mobile/**"],
      "thresholds": {
        "minTokens": 30,
        "semanticThreshold": 0.35
      }
    }
  ],
  "cross-formats": [
    ["javascript", "typescript"],
    ["css", "scss"]
  ],
  "crossFormats": "js-ts",
  "dead-code": {
    "enabled": false
  },
  "dead-code-categories": ["all"],
  "deadCode": {
    "categories": ["unused-file", "unused-export"],
    "entry": ["tools/*.js"],
    "minConfidence": 80
  },
  "deadCodeCategories": [
    "unused-file",
    "unused-export",
    "unused-symbol",
    "unused-import",
    "unused-member"
  ],
  "debug": false,
  "entry": ["src/index.ts"],
  "exit-code": 1,
  "fail-on-new-clones": 0,
  "failOnEmpty": true,
  "failOnNewClones": 3,
  "follow-symlinks": true,
  "followSymlinks": true,
  "format": ["astro", "cfscript", "svelte", "toml", "vue", "zig"],
  "formats": "typescript",
  "formats-exts": ["javascript:es,es6"],
  "formats-names": "makefile:Makefile,GNUmakefile",
  "formatsExts": "javascript:es,es6;dart:dt",
  "formatsNames": {
    "docker": "Dockerfile",
    "makefile": ["Makefile", "GNUmakefile"]
  },
  "health": {
    "complexFile": 80,
    "deadCode": {
      "weight": 0
    },
    "duplication": {
      "halfLife": 5,
      "weight": 2
    }
  },
  "health-input": "health-metrics.json",
  "healthInput": "health-metrics.json",
  "history": "v5.0.0..HEAD",
  "history-every": 5,
  "history-limit": 60,
  "history-since": "2026-01-01",
  "historyEvery": 1,
  "historyLimit": 30,
  "historySince": "2026-01-01",
  "ignore-annotations": true,
  "ignore-case": true,
  "ignore-identifiers": "blind",
  "ignore-literals": true,
  "ignore-pattern": ["//\\s*cpd-disable"],
  "ignoreAnnotations": false,
  "ignoreIdentifiers": true,
  "ignoreLiterals": false,
  "include-entry-exports": true,
  "include-tests": true,
  "includeEntryExports": false,
  "includeTests": false,
  "kind": ["exact", "renamed", "similar", "gap", "ast", "semantic"],
  "lsp": {
    "clones": {
      "enabled": true
    },
    "complexity": {
      "enabled": true
    }
  },
  "max-gap-lines": 2,
  "max-lines": 1000,
  "max-size": "1m",
  "maxGapLines": 3,
  "min-confidence": 50,
  "min-lines": 5,
  "min-nodes": 30,
  "min-tokens": 50,
  "minConfidence": 80,
  "minNodes": 20,
  "no-colors": true,
  "no-gitignore": false,
  "no-tips": true,
  "noColors": true,
  "noGitignore": false,
  "noTips": true,
  "path": ["./src", "./packages"],
  "report-name": "megalinter-jscpd",
  "reportName": "jscpd-report",
  "reporters": [
    "console",
    "consoleFull",
    "console-full",
    "full",
    "json",
    "html",
    "markdown",
    "badge",
    "sarif",
    "ai",
    "xcode",
    "threshold",
    "silent"
  ],
  "sarif-error-tokens": 200,
  "sarifErrorTokens": 100,
  "semantic": {
    "provider": "http",
    "scope": "cross",
    "threshold": 0.45,
    "url": "http://localhost:11434/v1"
  },
  "similarity": 0.8,
  "skip-isolated": [["libs/a", "libs/b"]],
  "skip-local": false,
  "skipIsolated": [
    ["packages/a", "packages/b"],
    ["libs/a", "libs/b"]
  ],
  "storePath": ".jscpd-cache",
  "summary": true,
  "summaryBy": "complexity",
  "summaryTop": 5
}
