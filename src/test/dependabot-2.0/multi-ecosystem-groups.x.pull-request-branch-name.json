{
  "multi-ecosystem-groups": {
    "all-properties": {
      "pull-request-branch-name": {
        "branch-name-case": "lowercase",
        "max-length": 60,
        "prefix": "deps",
        "separator": "-",
        "template": "{prefix}/{group_name}",
        "word-separator": "_"
      },
      "schedule": { "interval": "daily" }
    },
    "branch-name-case-lowercase": {
      "pull-request-branch-name": { "branch-name-case": "lowercase" },
      "schedule": { "interval": "daily" }
    },
    "branch-name-case-uppercase": {
      "pull-request-branch-name": { "branch-name-case": "uppercase" },
      "schedule": { "interval": "daily" }
    },
    "max-length-maximum": {
      "pull-request-branch-name": { "max-length": 244 },
      "schedule": { "interval": "daily" }
    },
    "max-length-minimum": {
      "pull-request-branch-name": { "max-length": 20 },
      "schedule": { "interval": "daily" }
    },
    "prefix": {
      "pull-request-branch-name": { "prefix": "deps" },
      "schedule": { "interval": "daily" }
    },
    "prefix-max-length": {
      "pull-request-branch-name": {
        "prefix": "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghij"
      },
      "schedule": { "interval": "daily" }
    },
    "prefix-min-length": {
      "pull-request-branch-name": { "prefix": "d" },
      "schedule": { "interval": "daily" }
    },
    "separator-dash": {
      "pull-request-branch-name": { "separator": "-" },
      "schedule": { "interval": "daily" }
    },
    "separator-slash": {
      "pull-request-branch-name": { "separator": "/" },
      "schedule": { "interval": "daily" }
    },
    "separator-underscore": {
      "pull-request-branch-name": { "separator": "_" },
      "schedule": { "interval": "daily" }
    },
    "template": {
      "pull-request-branch-name": {
        "template": "deps/{group_name}/{name}"
      },
      "schedule": { "interval": "daily" }
    },
    "template-single-character": {
      "pull-request-branch-name": { "template": "x" },
      "schedule": { "interval": "daily" }
    },
    "template-with-dot-at-underscore-dash": {
      "pull-request-branch-name": {
        "template": "deps-{group_name}_{name}.v2@version"
      },
      "schedule": { "interval": "daily" }
    },
    "word-separator": {
      "pull-request-branch-name": { "word-separator": "-" },
      "schedule": { "interval": "daily" }
    }
  },
  "updates": [
    {
      "directory": "/separator-slash",
      "multi-ecosystem-group": "separator-slash",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/separator-dash",
      "multi-ecosystem-group": "separator-dash",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/separator-underscore",
      "multi-ecosystem-group": "separator-underscore",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/prefix",
      "multi-ecosystem-group": "prefix",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/prefix-min-length",
      "multi-ecosystem-group": "prefix-min-length",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/prefix-max-length",
      "multi-ecosystem-group": "prefix-max-length",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/max-length-minimum",
      "multi-ecosystem-group": "max-length-minimum",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/max-length-maximum",
      "multi-ecosystem-group": "max-length-maximum",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/word-separator",
      "multi-ecosystem-group": "word-separator",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/branch-name-case-lowercase",
      "multi-ecosystem-group": "branch-name-case-lowercase",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/branch-name-case-uppercase",
      "multi-ecosystem-group": "branch-name-case-uppercase",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/template",
      "multi-ecosystem-group": "template",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/template-with-dot-at-underscore-dash",
      "multi-ecosystem-group": "template-with-dot-at-underscore-dash",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/template-single-character",
      "multi-ecosystem-group": "template-single-character",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    },
    {
      "directory": "/all-properties",
      "multi-ecosystem-group": "all-properties",
      "package-ecosystem": "npm",
      "patterns": ["*"]
    }
  ],
  "version": 2
}
