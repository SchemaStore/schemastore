{
  "updates": [
    {
      "directory": "/separator-slash",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "separator": "/"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/separator-dash",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "separator": "-"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/separator-underscore",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "separator": "_"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/prefix",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "prefix": "deps"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/prefix-min-length",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "prefix": "d"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/prefix-max-length",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "prefix": "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghij"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/max-length-minimum",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "max-length": 20
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/max-length-maximum",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "max-length": 244
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/word-separator",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "word-separator": "-"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/branch-name-case-lowercase",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "branch-name-case": "lowercase"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/branch-name-case-uppercase",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "branch-name-case": "uppercase"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/template",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "template": "deps/{package_manager}/{dependency}"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/template-with-dot-at-underscore-dash",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "template": "deps-{package_manager}_{dependency}.v2@version"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/template-single-character",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "template": "x"
      },
      "schedule": {
        "interval": "daily"
      }
    },
    {
      "directory": "/all-properties",
      "package-ecosystem": "npm",
      "pull-request-branch-name": {
        "branch-name-case": "lowercase",
        "max-length": 60,
        "prefix": "deps",
        "separator": "-",
        "template": "{prefix}/{package_manager}/{dependency}",
        "word-separator": "_"
      },
      "schedule": {
        "interval": "daily"
      }
    }
  ],
  "version": 2
}
