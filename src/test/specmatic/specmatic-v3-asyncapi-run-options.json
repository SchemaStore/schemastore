{
  "components": {
    "runOptions": {
      "orderService": {
        "asyncapi": {
          "replyTimeout": 15000,
          "schemaRegistry": {
            "kind": "CONFLUENT",
            "password": "${SCHEMA_REGISTRY_PASSWORD:admin-secret}",
            "url": "${SCHEMA_REGISTRY_URL:http://localhost:8081}",
            "username": "${SCHEMA_REGISTRY_USERNAME:admin}"
          },
          "servers": [
            {
              "server": {
                "adminCredentials": {
                  "sasl.mechanism": "PLAIN",
                  "security.protocol": "SASL_PLAINTEXT"
                },
                "client": {
                  "consumer": {
                    "auto.offset.reset": "earliest"
                  },
                  "producer": {
                    "acks": "all"
                  }
                },
                "host": "${KAFKA_BROKER:localhost:9092}",
                "protocol": "kafka",
                "type": "external"
              }
            },
            {
              "host": "tcp://localhost:61616",
              "protocol": "jms",
              "type": "external"
            }
          ],
          "specs": [
            {
              "spec": {
                "id": "orders",
                "servers": [
                  {
                    "server": {
                      "$serverRef": "#/servers/development",
                      "type": "external"
                    }
                  }
                ],
                "subscriberReadinessWaitTime": 3000
              }
            }
          ],
          "subscriberReadinessWaitTime": 1000,
          "type": "test"
        }
      }
    }
  },
  "version": 3
}
