{
  "components": {
    "runOptions": {
      "orderWorkflow": {
        "arazzo": {
          "baseUrls": {
            "orders": "${ORDERS_BASE_URL:http://localhost:8080}"
          },
          "security": {
            "profiles": {
              "ordersOAuth": {
                "oauth2": {
                  "clientAssertionAudience": "${OAUTH_CLIENT_ASSERTION_AUDIENCE:https://auth.example.com/token}",
                  "clientAuthentication": "${OAUTH_CLIENT_AUTH:private_key_jwt}",
                  "clientId": {
                    "env": "OAUTH_CLIENT_ID"
                  },
                  "grantType": "${OAUTH_GRANT_TYPE:client_credentials}",
                  "keyId": "${OAUTH_KEY_ID:orders-key}",
                  "privateKey": {
                    "env": "OAUTH_CLIENT_PRIVATE_KEY"
                  },
                  "signingAlgorithm": "${OAUTH_SIGNING_ALGORITHM:RS256}",
                  "tokenUrl": "${OAUTH_TOKEN_URL:https://auth.example.com/token}"
                }
              }
            }
          },
          "type": "test",
          "vault": {
            "profiles": {
              "local": {
                "environment": {
                  "VAULT_ADDR": "${VAULT_ENV_URL:https://vault.example.com}"
                },
                "mount": "${VAULT_MOUNT:secret}",
                "tokenKey": "${VAULT_TOKEN_ENV:VAULT_TOKEN}",
                "type": "hashicorp",
                "url": "${VAULT_URL:https://vault.example.com}",
                "version": "${VAULT_KV_VERSION:2}"
              }
            }
          }
        }
      }
    }
  },
  "version": 3
}
