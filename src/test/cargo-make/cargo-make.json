{
  "config": {
    "unstable_features": ["CTRL_C_HANDLING"]
  },
  "tasks": {
    "format": {
      "args": ["fmt", "--", "--emit=files"],
      "command": "cargo",
      "install_crate": "rustfmt"
    },
    "format2": {
      "condition": {
        "condition_type": "Or",
        "files_exist": ["src/main.rs", "src/lib.rs"]
      },
      "dependencies": ["format"]
    },
    "test_task": {
      "install_crate": {
        "crate_name": "cargo-expand",
        "version": "1.0.80"
      }
    }
  }
}
