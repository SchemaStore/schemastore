{
  "applications": {
    "gecko": {
      "id": "tb-example-mv2@example.org",
      "strict_min_version": "102.0"
    }
  },
  "author": "Example Author",
  "background": {
    "scripts": ["background.js"]
  },
  "cloudFile": {
    "management_url": "account2.html",
    "name": "My cloud provider 2"
  },
  "cloud_file": {
    "management_url": "account.html",
    "name": "My cloud provider"
  },
  "commands": {
    "compose-to-self": {
      "description": "Compose a message to yourself",
      "suggested_key": { "default": "Ctrl+Shift+1" }
    }
  },
  "compose_action": {
    "default_area": "maintoolbar",
    "default_icon": "compose.png",
    "default_title": "My compose action"
  },
  "compose_scripts": [{ "js": ["compose.js"] }],
  "description": "An example Thunderbird MaiExtension manifest (Manifest V2).",
  "manifest_version": 2,
  "message_display_action": {
    "browser_style": true,
    "default_title": "My message display action"
  },
  "message_display_scripts": [{ "js": ["message-display.js"] }],
  "name": "Thunderbird Mail Extension Example",
  "oauth_provider": {
    "authorizationEndpoint": "https://provider.example/authorize",
    "clientId": "my-client-id",
    "tokenEndpoint": "https://provider.example/token"
  },
  "optional_permissions": ["addressBooks", "accountsCreate"],
  "permissions": ["accountsRead", "compose", "cloudFile", "messagesRead"],
  "version": "1.0.0"
}
