{
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "My toolbar button"
  },
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "tb-example-mv3@example.org",
      "strict_min_version": "128.0"
    }
  },
  "cloud_file": { "management_url": "mgmt.html", "name": "cloud" },
  "compose_action": { "default_title": "compose" },
  "description": "An example Thunderbird MaiExtension manifest (Manifest V3).",
  "host_permissions": ["https://*.example.com/*"],
  "manifest_version": 3,
  "message_display_action": { "default_title": "display" },
  "name": "Thunderbird Mail Extension Example MV3",
  "oauth_provider": {
    "authorizationEndpoint": "https://provider.example/authorize",
    "clientId": "client",
    "tokenEndpoint": "https://provider.example/token"
  },
  "permissions": ["messagesRead", "compose", "addressBooks"],
  "version": "2.0.0",
  "web_accessible_resources": [
    { "matches": ["https://*.example.com/*"], "resources": ["welcome.html"] }
  ]
}
