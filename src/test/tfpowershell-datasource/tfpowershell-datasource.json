{
  "$schema": "https://json.schemastore.org/tfpowershell-datasource.json",
  "attributes": {
    "content": {
      "computed": true,
      "description": "The file's content.",
      "type": "string"
    },
    "exists": {
      "computed": true,
      "description": "Whether the file exists.",
      "type": "bool"
    },
    "path": {
      "description": "Path of the file to read.",
      "required": true,
      "type": "string"
    },
    "size": {
      "computed": true,
      "description": "Size in bytes.",
      "type": "int"
    }
  },
  "description": "Reads a text file on the machine running the provider.",
  "version": 1
}
