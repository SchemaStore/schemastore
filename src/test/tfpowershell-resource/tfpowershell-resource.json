{
  "$schema": "https://json.schemastore.org/tfpowershell-resource.json",
  "attributes": {
    "content": {
      "default": "",
      "description": "Content written to the file.",
      "optional": true,
      "type": "string"
    },
    "last_modified": {
      "computed": true,
      "description": "Last write time (UTC, ISO 8601).",
      "type": "string"
    },
    "path": {
      "description": "Path of the file to manage.",
      "required": true,
      "requires_replace": true,
      "type": "string"
    },
    "size": {
      "computed": true,
      "description": "Size of the file in bytes.",
      "type": "int"
    }
  },
  "description": "Manages a text file on the machine running the provider.",
  "version": 1
}
