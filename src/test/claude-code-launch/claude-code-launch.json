{
  "$schema": "https://www.schemastore.org/claude-code-launch.json",
  "version": "0.0.1",
  "autoVerify": false,
  "configurations": [
    {
      "name": "npm-development-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "autoPort": true
    },
    {
      "name": "node-server",
      "program": "server.js",
      "args": [
        "--verbose"
      ],
      "port": 4000
    },
    {
      "name": "existing-server",
      "url": "https://app.localhost:3000"
    }
  ]
}