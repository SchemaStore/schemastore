{
  "$schema": "https://www.schemastore.org/claude-code-launch.json",
  "autoVerify": false,
  "configurations": [
    {
      "autoPort": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "name": "npm-development-server",
      "port": 3000,
      "runtimeArgs": ["run", "dev"],
      "runtimeExecutable": "npm"
    },
    {
      "args": ["--verbose"],
      "name": "node-server",
      "port": 4000,
      "program": "server.js"
    },
    {
      "name": "existing-server",
      "url": "https://app.localhost:3000"
    }
  ],
  "version": "0.0.1"
}
