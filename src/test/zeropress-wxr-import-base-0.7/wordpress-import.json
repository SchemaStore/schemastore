{
  "$schema": "https://www.schemastore.org/zeropress-wxr-import-base-0.7.json",
  "comments": {
    "api_base_url": "https://example.com/wp-json/wp/v2",
    "enabled": true,
    "order": "desc",
    "per_page": 50,
    "provider": "wordpress",
    "threading": {
      "enabled": true,
      "max_depth": 2
    }
  },
  "import": {
    "media_rewrites": [
      {
        "from": "https://example.com/wp-content/uploads/",
        "to": "https://media.example.com/imported/"
      }
    ],
    "menu_mapping": {
      "footer": "34",
      "primary": "12"
    }
  },
  "site": {
    "archive": {
      "enabled": false
    },
    "locale": "en",
    "timezone": "UTC",
    "title": "Imported Site",
    "url": "https://example.com"
  },
  "version": "0.7"
}
