{
  "$schema": "https://www.schemastore.org/serve.json",
  "public": "dist",
  "cleanUrls": ["/app/**", "!/legacy/**"],
  "rewrites": [
    { "source": "/app/**", "destination": "/app/index.html" },
    { "source": "projects/:id", "destination": "/projects/:id.html" }
  ],
  "redirects": [
    { "source": "/from", "destination": "/to", "type": 302 },
    { "source": "/old/:slug", "destination": "https://example.com/:slug" }
  ],
  "headers": [
    {
      "source": "**/*.@(jpg|jpeg|gif|png)",
      "headers": [{ "key": "Cache-Control", "value": "max-age=7200" }]
    }
  ],
  "directoryListing": false,
  "unlisted": [".DS_Store", ".git"],
  "trailingSlash": true,
  "renderSingle": true,
  "symlinks": true,
  "etag": true
}
