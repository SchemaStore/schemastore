{
  "$schema": "https://www.schemastore.org/serve.json",
  "cleanUrls": ["/app/**", "!/legacy/**"],
  "directoryListing": false,
  "etag": true,
  "headers": [
    {
      "headers": [{ "key": "Cache-Control", "value": "max-age=7200" }],
      "source": "**/*.@(jpg|jpeg|gif|png)"
    }
  ],
  "public": "dist",
  "redirects": [
    { "destination": "/to", "source": "/from", "type": 302 },
    { "destination": "https://example.com/:slug", "source": "/old/:slug" }
  ],
  "renderSingle": true,
  "rewrites": [
    { "destination": "/app/index.html", "source": "/app/**" },
    { "destination": "/projects/:id.html", "source": "projects/:id" }
  ],
  "symlinks": true,
  "trailingSlash": true,
  "unlisted": [".DS_Store", ".git"]
}
