{
  "imaging": {
    "anchor": "Smart",
    "avif": {
      "compression": "lossy",
      "encoderSpeed": 8,
      "hint": "picture",
      "quality": 55
    },
    "bgColor": "#ffffff",
    "jpeg": {
      "quality": 71
    },
    "meta": {
      "fields": ["**", "! *GPS*"],
      "sources": ["exif", "iptc", "xmp"]
    },
    "resampleFilter": "CatmullRom",
    "webp": {
      "compression": "lossless",
      "hint": "drawing",
      "method": 4,
      "quality": 71,
      "useSharpYuv": true
    }
  }
}
