{
  "api-modules": ["app.cli"],
  "api-packages": ["app"],
  "docstring-style": "rst",
  "extend-fixable": ["SMP201"],
  "extend-per-file-ignores": {
    "docs/**.py": ["SMP9"]
  },
  "extend-safe-fixes": ["SMP002"],
  "extend-select": ["SMP304"],
  "extend-unfixable": ["SMP202"],
  "extend-unsafe-fixes": ["SMP003"],
  "fix": true,
  "fix-only": false,
  "fixable": ["SMP1"],
  "ignore": ["SMP601"],
  "imports": {
    "module-attributes": ["app.settings"]
  },
  "logic": {
    "max-caller-statements": 30,
    "max-helper-statements": 2
  },
  "max-paragraph-words": 80,
  "naming": {
    "keep-names": ["urlpatterns"]
  },
  "output-format": "concise",
  "per-file-ignores": {
    "tests/**.py": ["SMP8"]
  },
  "project-kind": "library",
  "select": ["SMP1", "SMP201"],
  "show-fixes": true,
  "unfixable": ["SMP601"],
  "unsafe-fixes": false
}
