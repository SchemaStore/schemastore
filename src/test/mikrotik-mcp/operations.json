{
  "alerts": {
    "channels": {
      "email": {
        "from": "mcp@example.org",
        "host": "mail.example.org",
        "to": "ops@example.org"
      },
      "telegram": {
        "chatId": "12345",
        "token": "example-only"
      }
    },
    "digest": {
      "channels": ["email", "telegram"],
      "hour": 8
    }
  },
  "approvals": {
    "minRisk": "DESTRUCTIVE",
    "notify": ["email"],
    "ttlMinutes": 15
  },
  "audit": {
    "syslog": {
      "host": "logs.example.org",
      "protocol": "tcp"
    }
  },
  "dashboard": {
    "files": false,
    "terminal": false
  },
  "devices": {
    "edge": {
      "host": "192.0.2.10",
      "hostKeySha256": "SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "passwordFrom": "env:EDGE_PASSWORD"
    }
  },
  "feedback": {
    "enabled": true
  },
  "gitMirror": {
    "commit": true,
    "dir": "./snapshots"
  },
  "logLevel": "warn",
  "mcp": {
    "coreTools": "get_web_proxy",
    "semanticSearch": true,
    "sessionIdleTimeout": 60000,
    "toolSurface": "core"
  },
  "verifyWrites": true,
  "vouchers": {
    "issue": {
      "maxPerMinute": 5,
      "tokenFrom": "file:/run/secrets/voucher-token"
    }
  }
}
