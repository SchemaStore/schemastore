{
  "storage": {
    "dataSets": {
      "animals": {
        "schemaFile": "data/animals.schema.json",
        "schemaType": "json-schema",
        "source": "data/animals.json"
      },
      "sales": { "databaseFile": "data/sales.db", "table": "sales" }
