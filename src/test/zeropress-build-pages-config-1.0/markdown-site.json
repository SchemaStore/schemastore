{
  "$schema": "https://www.schemastore.org/zeropress-build-pages-config-1.0.json",
  "collections": {
    "guides": {
      "items": ["getting-started/index.md", "deployment/index.md"],
      "title": "Guides"
    }
  },
  "custom_html": {
    "body_end": {
      "file": ".zeropress/body-end.html"
    },
    "head_end": {
      "file": ".zeropress/head-end.html"
    }
  },
  "front_page": {
    "type": "markdown"
  },
  "markdown": {
    "link_output": "clean",
    "updated_at": "git"
  },
  "menus": {
    "primary": {
      "items": [
        {
          "title": "Home",
          "url": "/"
        },
        {
          "meta": {
            "badge": "New",
            "icon": "book-open"
          },
          "title": "Docs",
          "url": "/docs/"
        }
      ],
      "name": "Primary Menu"
    }
  },
  "site": {
    "description": "Public documentation.",
    "expose_generator": true,
    "locale": "en-US",
    "logo": {
      "alt": "Example Documentation",
      "src": "/logo.svg"
    },
    "meta": {
      "issue": "Spring 2026"
    },
    "robots": {
      "allow_indexing": true
    },
    "search": true,
    "title": "Example Documentation",
    "url": "https://docs.example.com"
  },
  "version": "1.0"
}
