{
  "group": {
    "default": {
      "description": "Build and lint everything",
      "targets": ["app", "lint"]
    }
  },
  "target": {
    "app": {
      "call": "check",
      "context": ".",
      "description": "Builds the application image",
      "entitlements": ["network.host", "security.insecure"],
      "extra-hosts": {
        "my_hostname": "8.8.8.8"
      },
      "network": "none",
      "policy": [
        "filename=extra.rego",
        {
          "filename": "extra.rego",
          "strict": true
        }
      ],
      "resources": {
        "cpu-quota": 50000,
        "cpuset-cpus": "0-1",
        "memory": "2g",
        "memory-swap": "4g"
      }
    },
    "lint": {
      "description": "Runs golangci-lint to detect style errors",
      "dockerfile": "lint.Dockerfile"
    }
  }
}
