{
  "autoContinueAtUsageLimit": "yes",
  "cleanupPeriodDays": "thirty",
  "enableAllProjectMcpServers": 1,
  "enableWorkflows": "on",
  "fastMode": "yes",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "async": "true",
            "command": "echo test",
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": "yes",
  "permissions": {
    "additionalDirectories": "should be array",
    "allow": "should be array",
    "ask": "should be array"
  },
  "promptSuggestionEnabled": 1,
  "sandbox": {
    "network": {
      "allowAllUnixSockets": "yes",
      "allowedDomains": "api.anthropic.com",
      "deniedDomains": "should-be-array"
    }
  },
  "strictKnownMarketplaces": [
    {
      "hostPattern": 123,
      "source": "hostPattern"
    }
  ],
  "switchModelsOnFlag": "true"
}
